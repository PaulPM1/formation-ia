---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getTriggerVariant, triggerLaneLabels } from './visual-state';

interface Props { slide: RoutedSlide; }
interface TriggerMode { name: string; trigger: string; execution: string; example: string; }
interface ScheduleState { name: string; action: string; }
interface Guardrail { name: string; evidence: string; }
interface Lifecycle { state: string; proof: string; }
interface ScheduledTask { source?: string; output?: string; actionLimit?: string; missingData?: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getTriggerVariant(data);
const modes = (Array.isArray(data.modes) ? data.modes : []) as TriggerMode[];
const timeline = Array.isArray(data.timeline) ? data.timeline.map(String) : [];
const task = (data.task ?? {}) as ScheduledTask;
const scheduleStates = (Array.isArray(data.states) ? data.states : []) as ScheduleState[];
const guardrails = (Array.isArray(data.guardrails) ? data.guardrails : []) as Guardrail[];
const lifecycle = (Array.isArray(data.lifecycle) ? data.lifecycle : []) as Lifecycle[];
const laneLabels = triggerLaneLabels(data);
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="trigger-timeline">
  <div class="trigger" data-trigger-timeline data-variant={variant} data-enhanced="false">
    <svg class="trigger__lanes" viewBox="0 0 1000 250" role="img" aria-labelledby={`${slide.id}-trigger-title ${slide.id}-trigger-desc`}>
      <title id={`${slide.id}-trigger-title`}>Deux lignes alignées : événement et calendrier</title>
      <desc id={`${slide.id}-trigger-desc`}>La première ligne déclenche une règle quand un événement arrive. La seconde déclenche une nouvelle session manuellement puis selon une cadence.</desc>
      <defs><marker id={`${slide.id}-trigger-arrow`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0 L9 4.5 L0 9 Z" /></marker></defs>
      <g data-trigger-lane="event">
        <text class="trigger__lane-name" x="18" y="73">ÉVÉNEMENT</text><path d="M165 68 H940" marker-end={`url(#${slide.id}-trigger-arrow)`} />
        <circle cx="360" cy="68" r="28" /><text x="360" y="73" text-anchor="middle">Hook</text>
        <rect x="570" y="39" width="214" height="58" rx="8" /><text x="677" y="73" text-anchor="middle">{laneLabels.event}</text>
      </g>
      <g data-trigger-lane="calendar">
        <text class="trigger__lane-name" x="18" y="185">CALENDRIER</text><path d="M165 180 H940" marker-end={`url(#${slide.id}-trigger-arrow)`} />
        <circle cx="360" cy="180" r="28" /><text x="360" y="185" text-anchor="middle">Manuel</text>
        <rect x="570" y="151" width="214" height="58" rx="8" /><text x="677" y="185" text-anchor="middle">{laneLabels.calendar}</text>
      </g>
    </svg>

    {variant === 'modes' && (
      <section class="trigger__modes" aria-label="Comparer événement et cadence">
        {modes.map((mode) => <article data-trigger-panel><button type="button" disabled data-trigger-choice aria-pressed="false">{mode.name}</button><dl><div><dt>Déclencheur</dt><dd>{mode.trigger}</dd></div><div><dt>Exécution</dt><dd>{mode.execution}</dd></div></dl><strong>{mode.example}</strong></article>)}
        <p>{(Array.isArray(data.classificationPrompt) ? data.classificationPrompt : []).map(String).join(' ↔ ')}</p>
      </section>
    )}

    {variant === 'hook' && (
      <section class="trigger__hook" aria-label="Déclencher puis retirer le hook local">
        <div class="trigger__hook-config"><p>{String(data.configFile ?? '')}</p><code>{String(data.command ?? '')}</code><strong>{String(data.safety ?? '')}</strong></div>
        <ol>{timeline.map((item, index) => <li data-trigger-step><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>)}</ol>
        <div class="trigger__hook-actions" role="group" aria-label={String(data.interaction ?? '')}><button type="button" disabled data-trigger-hook>Exécuter le hook</button><button type="button" disabled data-trigger-disable>Désactiver puis retester</button></div>
      </section>
    )}

    {variant === 'schedule' && (
      <section class="trigger__schedule" aria-label="Du brouillon à la récurrence validée">
        <article><p>Entrée autorisée</p><strong>{task.source}</strong><p>Sortie</p><strong>{task.output}</strong><small>{task.actionLimit} · {task.missingData}</small></article>
        <ol>{scheduleStates.map((state, index) => <li data-trigger-panel><button type="button" disabled data-trigger-choice aria-pressed={index === 0}><span>{String(index + 1).padStart(2, '0')}</span>{state.name}</button><p>{state.action}</p></li>)}</ol>
        <p class="trigger__policy">{String(data.sessionPolicy ?? '')}</p>
      </section>
    )}

    {variant === 'guardrails' && (
      <section class="trigger__guardrails" aria-label="Six preuves avant activation">
        <div>{guardrails.map((guardrail) => <label><input type="checkbox" disabled data-trigger-guardrail /><span><strong>{guardrail.name}</strong>{guardrail.evidence}</span></label>)}</div>
        <aside><strong>Porte d’activation</strong><p>{String(data.activationGate ?? '')}</p><button type="button" disabled data-trigger-apply>{String(data.interaction ?? 'Ajouter les garde-fous')}</button></aside>
      </section>
    )}

    {variant === 'lifecycle' && (
      <section class="trigger__lifecycle" aria-label="Cycle de vie complet et arrêtable">
        <ol>{lifecycle.map((item, index) => <li data-trigger-panel data-lifecycle-index={index}><button type="button" disabled data-trigger-lifecycle aria-pressed="false"><span>{String(index + 1).padStart(2, '0')}</span>{item.state}</button><p>{item.proof}</p></li>)}</ol>
        <div class="trigger__final-state" data-trigger-final><strong>État final visible : Supprimé</strong><span>Configuration absente · accès retiré</span><small>Journal consulté · pause effectuée · {String(data.retention ?? '')}</small></div>
      </section>
    )}

    <output class="trigger__status" data-trigger-status aria-live="polite">Hook, exécution manuelle, récurrence, journal, pause et suppression restent visibles.</output>
  </div>
</SceneFrame>

<script>
  import { triggerLifecycleState } from './visual-state';

  document.querySelectorAll<HTMLElement>('[data-trigger-timeline]').forEach((scene) => {
    scene.dataset.enhanced = 'true';
    const status = scene.querySelector<HTMLOutputElement>('[data-trigger-status]');
    const buttons = Array.from(scene.querySelectorAll<HTMLButtonElement>('button'));
    buttons.forEach((button) => { button.disabled = false; });
    const choices = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-trigger-choice]'));
    choices.forEach((button) => button.addEventListener('click', () => {
      choices.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      scene.querySelectorAll<HTMLElement>('[data-trigger-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.contains(button)));
      if (status) status.textContent = button.closest<HTMLElement>('[data-trigger-panel]')?.innerText.replace(/\s+/g, ' ').trim() ?? button.innerText;
    }));
    scene.querySelector<HTMLButtonElement>('[data-trigger-hook]')?.addEventListener('click', () => {
      scene.dataset.hookState = 'triggered';
      if (status) status.textContent = 'Hook exécuté : HOOK_DEMO_TERMINE. Aucun fichier métier modifié.';
    });
    scene.querySelector<HTMLButtonElement>('[data-trigger-disable]')?.addEventListener('click', () => {
      scene.dataset.hookState = 'disabled';
      if (status) status.textContent = 'Hook retiré du fichier local. Le second test reste silencieux.';
    });
    const guardrails = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-trigger-guardrail]'));
    guardrails.forEach((input) => { input.disabled = false; });
    scene.querySelector<HTMLButtonElement>('[data-trigger-apply]')?.addEventListener('click', () => {
      guardrails.forEach((input) => { input.checked = true; });
      if (status) status.textContent = 'Six garde-fous présents : la porte exige encore le propriétaire nommé.';
    });
    const lifecycleButtons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-trigger-lifecycle]'));
    const names = lifecycleButtons.map((button) => button.textContent?.replace(/^\d+/, '').trim() ?? '');
    lifecycleButtons.forEach((button, index) => button.addEventListener('click', () => {
      const state = triggerLifecycleState(names, index);
      lifecycleButtons.forEach((candidate, candidateIndex) => candidate.setAttribute('aria-pressed', String(candidateIndex === state.index)));
      scene.dataset.lifecycleState = state.deleted ? 'deleted' : state.paused ? 'paused' : state.logVisible ? 'logged' : 'running';
      if (status) status.textContent = `${state.state} · journal ${state.logVisible ? 'visible' : 'pas encore produit'} · pause ${state.paused ? 'confirmée' : 'disponible'} · suppression ${state.deleted ? 'confirmée' : 'disponible'}.`;
    }));
  });
</script>

<style>
  .trigger { --c-meta: var(--c-font-meta, .75rem); --c-body: var(--c-font-body, .82rem); display: grid; gap: .28rem; min-inline-size: 0; }
  .trigger__lanes { inline-size: 100%; max-block-size: 6.7rem; overflow: visible; }
  .trigger[data-variant='schedule'] .trigger__lanes { max-block-size: 6.1rem; }
  .trigger__lanes path { fill: none; stroke: var(--presentation-ink); stroke-width: 6; stroke-linecap: round; }
  .trigger__lanes marker path { fill: var(--presentation-ink); }
  .trigger__lanes circle, .trigger__lanes rect { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; }
  .trigger__lanes [data-trigger-lane='event'] circle { fill: color-mix(in srgb, var(--family-accent), white 65%); }
  .trigger__lanes [data-trigger-lane='calendar'] rect { fill: color-mix(in srgb, var(--family-accent), white 78%); }
  .trigger__lanes text { fill: var(--presentation-ink); font: 740 16px var(--font-display); }
  .trigger__lanes .trigger__lane-name { font: 750 13px var(--font-mono); }
  .trigger button { min-inline-size: 0; padding: .25rem .4rem; border: 2px solid var(--presentation-ink); background: var(--presentation-surface); color: var(--presentation-ink); font: 750 var(--c-body) var(--font-display); cursor: pointer; }
  .trigger button:disabled { cursor: default; opacity: 1; }
  .trigger button[aria-pressed='true'] { border-block-end-width: .42rem; border-block-end-color: var(--family-accent); }
  .trigger__modes { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .trigger__modes article { display: grid; gap: .18rem; padding: .3rem; border: 1px solid var(--presentation-line); }
  .trigger__modes dl { display: grid; grid-template-columns: 1fr 1fr; gap: .3rem; margin: 0; }
  .trigger__modes dl div { padding-block-start: .25rem; border-block-start: 1px solid var(--presentation-line); }
  .trigger__modes dt { font: 700 var(--c-meta) var(--font-mono); text-transform: uppercase; }
  .trigger__modes dd { margin: 0; font-size: var(--c-body); }
  .trigger__modes strong { font-size: var(--c-body); }
  .trigger__modes > p { grid-column: 1 / -1; margin: 0; font: 760 var(--c-body) var(--font-display); text-align: center; }
  .trigger__hook { display: grid; grid-template-columns: minmax(12rem, .7fr) minmax(20rem, 1.3fr); gap: .55rem; }
  .trigger__hook-config { display: grid; gap: .25rem; align-content: center; padding: .55rem; border-block-start: .5rem solid var(--family-accent); background: var(--presentation-surface); }
  .trigger__hook-config p { margin: 0; font: 700 var(--c-meta) var(--font-mono); overflow-wrap: anywhere; }
  .trigger__hook-config code { font-size: var(--c-body); font-weight: 750; overflow-wrap: anywhere; }
  .trigger__hook-config strong { font-size: var(--c-body); }
  .trigger__hook ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .2rem; margin: 0; padding: 0; list-style: none; }
  .trigger__hook li { display: grid; gap: .12rem; min-inline-size: 0; padding: .35rem; border-block-start: .3rem solid var(--presentation-line); }
  .trigger__hook li:nth-child(3) { border-color: var(--family-accent); }
  .trigger__hook li span { font: 700 var(--c-meta) var(--font-mono); }
  .trigger__hook li strong { font-size: var(--c-body); overflow-wrap: anywhere; }
  .trigger__hook-actions { grid-column: 1 / -1; display: flex; gap: .35rem; justify-content: center; }
  .trigger[data-hook-state='triggered'] .trigger__hook li:nth-child(-n+3), .trigger[data-hook-state='disabled'] .trigger__hook li { border-block-start-width: .55rem; }
  .trigger[data-hook-state='disabled'] .trigger__hook li:last-child::after { content: 'Silencieux ✓'; font: 700 var(--c-meta) var(--font-mono); }
  .trigger__schedule { display: grid; grid-template-columns: minmax(14rem, .8fr) minmax(22rem, 1.2fr); gap: .55rem; }
  .trigger__schedule > article { display: grid; gap: .2rem; padding: .5rem; border: 2px solid var(--presentation-ink); }
  .trigger__schedule > article p { margin: 0; font: 700 var(--c-meta) var(--font-mono); text-transform: uppercase; }
  .trigger__schedule > article strong { font-size: var(--c-body); }
  .trigger__schedule > article small { font-size: var(--c-meta); font-weight: 700; }
  .trigger__schedule ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .trigger__schedule li { display: grid; gap: .22rem; min-inline-size: 0; }
  .trigger__schedule button { display: flex; gap: .3rem; align-items: center; text-align: start; }
  .trigger__schedule button span { font: 700 var(--c-meta) var(--font-mono); }
  .trigger__schedule li p { margin: 0; padding: .25rem; font-size: var(--c-body); overflow-wrap: anywhere; }
  .trigger__policy { grid-column: 1 / -1; margin: 0; padding-inline-start: .5rem; border-inline-start: .35rem solid var(--family-accent); font-size: var(--c-body); font-weight: 740; }
  .trigger__guardrails { display: grid; grid-template-columns: 1.35fr .65fr; gap: .55rem; }
  .trigger__guardrails > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .18rem; }
  .trigger__guardrails label { display: flex; gap: .3rem; min-inline-size: 0; padding: .22rem; border: 1px solid var(--presentation-line); font-size: var(--c-body); line-height: 1.05; }
  .trigger__guardrails input { flex: none; inline-size: 1.1rem; block-size: 1.1rem; accent-color: var(--presentation-ink); }
  .trigger__guardrails label span { display: grid; min-inline-size: 0; overflow-wrap: anywhere; }
  .trigger__guardrails aside { display: grid; gap: .18rem; align-content: center; padding: .32rem; border: .3rem solid var(--family-accent); }
  .trigger__guardrails aside strong { font: 780 1rem var(--font-display); }
  .trigger__guardrails aside p { margin: 0; font-size: var(--c-body); }
  .trigger__lifecycle { display: grid; grid-template-columns: 1.5fr .5fr; gap: .55rem; }
  .trigger__lifecycle ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .2rem; margin: 0; padding: 0; list-style: none; }
  .trigger__lifecycle li { display: grid; gap: .22rem; min-inline-size: 0; }
  .trigger__lifecycle button { display: flex; gap: .25rem; align-items: center; text-align: start; }
  .trigger__lifecycle button span { font: 700 var(--c-meta) var(--font-mono); }
  .trigger__lifecycle li p { margin: 0; padding: .25rem; font-size: var(--c-body); overflow-wrap: anywhere; }
  .trigger__final-state { display: grid; gap: .2rem; align-content: center; padding: .55rem; border: .3rem solid var(--presentation-ink); border-block-start-color: var(--family-accent); }
  .trigger__final-state strong { font: 780 1rem var(--font-display); }
  .trigger__final-state span, .trigger__final-state small { font-size: var(--c-body); }
  .trigger[data-lifecycle-state='deleted'] .trigger__final-state::before { content: '🔒 ARRÊT CONFIRMÉ'; font: 800 var(--c-meta) var(--font-mono); }
  .trigger__status { min-block-size: .9rem; font: 700 var(--c-meta)/1.05 var(--font-mono); }
  [data-trigger-panel].is-active { outline: .28rem solid color-mix(in srgb, var(--family-accent), transparent 15%); outline-offset: -.28rem; }
  @media (max-width: 48rem) {
    .trigger__lanes { max-block-size: 7.2rem; }
    .trigger__modes, .trigger__hook, .trigger__schedule, .trigger__guardrails, .trigger__lifecycle { grid-template-columns: 1fr; }
    .trigger__hook ol, .trigger__lifecycle ol { grid-template-columns: 1fr 1fr; }
    .trigger__guardrails > div { grid-template-columns: 1fr 1fr; }
    .trigger__policy, .trigger__hook-actions { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .trigger *, .trigger *::before, .trigger *::after { animation: none !important; transition: none !important; } }
</style>
