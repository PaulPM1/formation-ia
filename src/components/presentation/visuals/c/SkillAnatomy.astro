---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getSkillVariant, skillCaseOutcome } from './visual-state';

interface Props { slide: RoutedSlide; }
interface Concept { name: string; question: string; example: string; }
interface SkillSection { name: string; fields: string[]; purpose: string; }
interface DescriptionTest { text: string; result: string; diagnosis: string; }
interface SkillTest { type: string; prompt: string; expected: string; }
interface ExtractedMethod { name?: string; responsibility?: string; steps?: number; output?: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getSkillVariant(data);
const repeatedPrompts = Array.isArray(data.repeatedPrompts) ? data.repeatedPrompts.map(String) : [];
const method = (data.extractedMethod ?? {}) as ExtractedMethod;
const concepts = (Array.isArray(data.concepts) ? data.concepts : []) as Concept[];
const sections = (Array.isArray(data.sections) ? data.sections : []) as SkillSection[];
const descriptions = (Array.isArray(data.descriptions) ? data.descriptions : []) as DescriptionTest[];
const cases = (Array.isArray(data.cases) ? data.cases : []) as SkillTest[];
const assertions = Array.isArray(data.assertions) ? data.assertions.map(String) : [];
const anatomyParts = sections.length ? sections : [
  { name: 'Description', fields: ['Ce que fait le Skill', 'Quand l’utiliser'], purpose: 'Déclenchement ciblé' },
  { name: 'Procédure', fields: [`${method.steps ?? 4} étapes observables`], purpose: method.responsibility ?? 'Exécution stable' },
  { name: 'Sortie', fields: [method.output ?? 'Forme annoncée'], purpose: 'Conformité vérifiable' },
];
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="skill-anatomy">
  <div class="skill" data-skill-anatomy data-variant={variant} data-enhanced="false">
    <svg class="skill__spine" viewBox="0 0 900 112" role="img" aria-labelledby={`${slide.id}-skill-title ${slide.id}-skill-desc`}>
      <title id={`${slide.id}-skill-title`}>La méthode devient un fichier SKILL.md testable</title>
      <desc id={`${slide.id}-skill-desc`}>Une ligne relie la description qui déclenche, la procédure qui guide et la sortie qui prouve le résultat.</desc>
      <path d="M95 56 H805" marker-end={`url(#${slide.id}-skill-arrow)`} />
      <defs><marker id={`${slide.id}-skill-arrow`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0 L9 4.5 L0 9 Z" /></marker></defs>
      {['Description', 'Procédure', 'Sortie'].map((label, index) => <g transform={`translate(${145 + index * 300} 56)`}><rect x="-68" y="-27" width="136" height="54" rx="27" /><text text-anchor="middle" y="5">{label}</text></g>)}
    </svg>

    {variant === 'repeat' && (
      <section class="skill__repeat" aria-label="Extraction d’une méthode répétée">
        <ol>{repeatedPrompts.map((prompt, index) => <li><span>Copie {index + 1}</span><strong>{prompt}</strong></li>)}</ol>
        <button type="button" disabled data-skill-extract>Extraire la méthode <span aria-hidden="true">→</span></button>
        <article data-skill-method>
          <p>SKILL.md</p><h3>{method.name}</h3><strong>{method.responsibility}</strong>
          <dl><div><dt>Procédure</dt><dd>{method.steps} étapes</dd></div><div><dt>Sortie</dt><dd>{method.output}</dd></div></dl>
          <small>{String(data.decisionRule ?? '')}</small>
        </article>
      </section>
    )}

    {variant === 'neighbors' && (
      <section class="skill__neighbors" aria-label="Quatre notions aux responsabilités différentes">
        {concepts.map((concept) => <article data-skill-panel><button type="button" disabled data-skill-choice aria-pressed="false">{concept.name}</button><p>{concept.question}</p><strong>{concept.example}</strong></article>)}
      </section>
    )}

    {variant === 'anatomy' && (
      <section class="skill__cutaway" aria-label="Coupe du fichier SKILL.md">
        <header><span>{String(data.file ?? 'SKILL.md')}</span><strong>Lisible · borné · testable</strong></header>
        <div class="skill__cutaway-parts">
          {anatomyParts.map((section, index) => <article data-skill-panel>
            <button type="button" disabled data-skill-choice aria-pressed="false"><span>{String(index + 1).padStart(2, '0')}</span>{section.name}</button>
            <ul>{section.fields.map((field) => <li>{field}</li>)}</ul><strong>{section.purpose}</strong>
          </article>)}
        </div>
      </section>
    )}

    {variant === 'trigger' && (
      <section class="skill__descriptions" aria-label="Test de deux descriptions">
        {descriptions.map((item, index) => <article data-skill-panel class:list={{ 'is-targeted': index === descriptions.length - 1 }}>
          <button type="button" disabled data-skill-choice aria-pressed="false">Tester la description {index + 1}</button>
          <blockquote>{item.text}</blockquote><strong>{item.result}</strong><p>{item.diagnosis}</p>
        </article>)}
      </section>
    )}

    {variant === 'tests' && (
      <section class="skill__tests" aria-label="Cas positif et cas négatif">
        <div class="skill__case-grid">
          {cases.map((testCase) => {
            const outcome = skillCaseOutcome(testCase);
            return <article data-skill-panel data-should-trigger={String(outcome.shouldTrigger)}>
              <button type="button" disabled data-skill-case aria-pressed="false">Lancer le cas {testCase.type.toLocaleLowerCase('fr')}</button>
              <p>{testCase.prompt}</p><strong><span aria-hidden="true">{outcome.shouldTrigger ? '▶' : '⏸'}</span> {outcome.state}</strong><small>Attendu : {testCase.expected}</small>
            </article>;
          })}
        </div>
        <ul class="skill__assertions">{assertions.map((assertion) => <li><span aria-hidden="true">✓</span>{assertion}</li>)}</ul>
      </section>
    )}

    <output class="skill__status" data-skill-status aria-live="polite">Tous les éléments nécessaires sont visibles.</output>
  </div>
</SceneFrame>

<script>
  document.querySelectorAll<HTMLElement>('[data-skill-anatomy]').forEach((scene) => {
    scene.dataset.enhanced = 'true';
    const status = scene.querySelector<HTMLOutputElement>('[data-skill-status]');
    const method = scene.querySelector<HTMLElement>('[data-skill-method]');
    const extract = scene.querySelector<HTMLButtonElement>('[data-skill-extract]');
    if (extract) {
      extract.disabled = false;
      extract.addEventListener('click', () => {
        method?.classList.toggle('is-extracted');
        if (status) status.textContent = 'La répétition est maintenant une méthode nommée, bornée et testable.';
      });
    }
    const buttons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-skill-choice], [data-skill-case]'));
    buttons.forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
        scene.querySelectorAll<HTMLElement>('[data-skill-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.contains(button)));
        if (status) status.textContent = button.closest<HTMLElement>('[data-skill-panel]')?.innerText.replace(/\s+/g, ' ').trim() ?? '';
      });
    });
  });
</script>

<style>
  .skill { --c-meta: var(--c-font-meta, .72rem); --c-body: var(--c-font-body, .82rem); display: grid; gap: .28rem; min-inline-size: 0; }
  .skill__spine { inline-size: 100%; max-block-size: 6.5rem; overflow: visible; }
  .skill[data-variant='tests'] .skill__spine { max-block-size: 4.9rem; }
  .skill__spine > path { fill: none; stroke: var(--presentation-ink); stroke-width: 6; stroke-linecap: round; }
  .skill__spine marker path { fill: var(--presentation-ink); }
  .skill__spine rect { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; }
  .skill__spine g:nth-of-type(1) rect { fill: color-mix(in srgb, var(--family-accent), white 70%); }
  .skill__spine text { fill: var(--presentation-ink); font: 750 16px var(--font-display); }
  .skill button { min-inline-size: 0; border: 2px solid var(--presentation-ink); background: var(--presentation-surface); color: var(--presentation-ink); font: 760 var(--c-body) var(--font-display); cursor: pointer; }
  .skill button:disabled { cursor: default; opacity: 1; }
  .skill button[aria-pressed='true'] { border-block-end-width: .45rem; border-block-end-color: var(--family-accent); }
  .skill__repeat { display: grid; grid-template-columns: minmax(12rem, .85fr) auto minmax(17rem, 1.15fr); gap: .7rem; align-items: center; }
  .skill__repeat ol { display: grid; gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .skill__repeat li { display: grid; grid-template-columns: auto 1fr; gap: .45rem; padding: .45rem; border: 1px solid var(--presentation-line); font-size: var(--c-body); }
  .skill__repeat li span, .skill__repeat article > p, .skill__cutaway header span { margin: 0; color: var(--presentation-muted); font: 700 var(--c-meta) var(--font-mono); text-transform: uppercase; }
  .skill__repeat > button { padding: .55rem; writing-mode: vertical-rl; }
  .skill__repeat article { display: grid; gap: .25rem; padding: .7rem; border: 3px solid var(--presentation-ink); border-block-start: .65rem solid var(--family-accent); background: var(--presentation-surface); transition: transform 180ms ease; }
  .skill__repeat article.is-extracted { transform: translateY(-.25rem); }
  .skill__repeat h3 { margin: 0; font: 790 clamp(1.2rem, 2vw, 1.7rem) var(--font-display); }
  .skill__repeat dl { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; margin: 0; }
  .skill__repeat dl div { padding-block-start: .3rem; border-block-start: 1px solid var(--presentation-line); }
  .skill__repeat dt { font: 700 var(--c-meta) var(--font-mono); text-transform: uppercase; }
  .skill__repeat dd { margin: 0; font-size: var(--c-body); }
  .skill__repeat small { font-size: var(--c-meta); font-weight: 700; }
  .skill__neighbors, .skill__descriptions, .skill__case-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr)); gap: .55rem; }
  .skill__neighbors article, .skill__descriptions article, .skill__case-grid article { display: grid; gap: .3rem; min-inline-size: 0; padding: .55rem; border: 1px solid var(--presentation-line); background: var(--presentation-surface); }
  .skill__neighbors button, .skill__descriptions button, .skill__case-grid button { padding: .42rem; }
  .skill__neighbors p, .skill__neighbors strong, .skill__descriptions p, .skill__case-grid p { margin: 0; font-size: var(--c-body); overflow-wrap: anywhere; }
  .skill__neighbors p { color: var(--presentation-muted); font-family: var(--font-mono); }
  .skill__neighbors article.is-active, .skill__descriptions article.is-active, .skill__case-grid article.is-active { outline: .28rem solid color-mix(in srgb, var(--family-accent), transparent 15%); outline-offset: -.28rem; }
  .skill__cutaway { border: 3px solid var(--presentation-ink); background: var(--presentation-surface); }
  .skill__cutaway header { display: flex; justify-content: space-between; gap: .5rem; padding: .25rem .5rem; border-block-end: 2px solid var(--presentation-ink); }
  .skill__cutaway header strong { font-size: var(--c-body); }
  .skill__cutaway-parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .skill__cutaway article { display: grid; gap: .15rem; min-inline-size: 0; padding: .3rem; border-inline-end: 1px solid var(--presentation-line); }
  .skill__cutaway article:last-child { border: 0; }
  .skill__cutaway button { display: flex; gap: .35rem; align-items: center; padding: .25rem; text-align: start; }
  .skill__cutaway button span { font: 700 var(--c-meta) var(--font-mono); }
  .skill__cutaway ul { margin: 0; padding-inline-start: .9rem; font-size: var(--c-body); line-height: 1.08; }
  .skill__cutaway article > strong { font-size: var(--c-body); }
  .skill__descriptions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .skill__descriptions blockquote { margin: 0; padding: .5rem; border-inline-start: .32rem solid var(--presentation-line); font: 720 clamp(.85rem, 1.4vw, 1.05rem) var(--font-display); }
  .skill__descriptions .is-targeted blockquote { border-color: var(--family-accent); }
  .skill__descriptions strong { font-size: var(--c-body); }
  .skill__tests { display: grid; gap: .55rem; }
  .skill__case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .skill__case-grid strong { font: 780 1rem var(--font-display); }
  .skill__case-grid small { font-size: var(--c-meta); }
  .skill__assertions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .skill__assertions li { padding: .38rem; border-block-start: .24rem solid var(--family-accent); font-size: var(--c-body); font-weight: 740; text-align: center; }
  .skill__assertions span { margin-inline-end: .3rem; }
  .skill__status { min-block-size: .9rem; font: 700 var(--c-meta)/1.05 var(--font-mono); }
  @media (max-width: 48rem) {
    .skill__spine { max-block-size: 4.2rem; }
    .skill__repeat { grid-template-columns: 1fr; }
    .skill__repeat > button { writing-mode: horizontal-tb; }
    .skill__cutaway-parts, .skill__descriptions, .skill__case-grid, .skill__assertions { grid-template-columns: 1fr; }
    .skill__cutaway article { border-inline-end: 0; border-block-end: 1px solid var(--presentation-line); }
  }
  @media (prefers-reduced-motion: reduce) { .skill *, .skill *::before, .skill *::after { animation: none !important; transition: none !important; } }
</style>
