---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getArtifactVariant } from './visual-state';

interface Props { slide: RoutedSlide; }
interface TestCase { name: string; action: string; expected: string; }
interface Zone { name: string; role: string; }
interface ArtifactSide { location: string; output: string; }
interface Iteration { passing: string[]; failing: string[]; }
interface Panel { label: string; title: string; body: string; note?: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getArtifactVariant(data);
const isLoopVariant = variant === 'tests' || variant === 'correction';
const tests = (Array.isArray(data.tests) ? data.tests : []) as TestCase[];
const zones = (Array.isArray(data.zones) ? data.zones : []) as Zone[];
const before = (data.before ?? {}) as ArtifactSide;
const after = (data.after ?? {}) as ArtifactSide;

// Le texte SVG ne se replie pas : découpe manuelle en deux lignes max
// pour rester dans les rectangles de 210 unités.
const wrapSvgText = (value: string | undefined, max = 18): string[] => {
  const text = String(value ?? '');
  if (text.length <= max) return [text];
  const words = text.split(' ');
  const first: string[] = [];
  while (words.length && `${first.join(' ')} ${words[0]}`.trim().length <= max) {
    first.push(words.shift() as string);
  }
  if (!first.length && words.length) first.push(words.shift() as string);
  return [first.join(' '), words.join(' ')].filter(Boolean);
};
const beforeLines = wrapSvgText(before.output);
const afterLines = wrapSvgText(after.output);
const iteration1 = (data.iteration1 ?? {}) as Iteration;
const iteration2 = (data.iteration2 ?? {}) as Iteration;
const removed = Array.isArray(data.removed) ? data.removed.map(String) : [];
const affordances = Array.isArray(data.affordances) ? data.affordances.map(String) : [];
let panels: Panel[] = [];
if (variant === 'transfer') panels = [
  { label: 'Avant', title: before.location, body: before.output },
  { label: 'Après', title: after.location, body: after.output, note: affordances.join(' · ') },
];
if (variant === 'anatomy') panels = zones.map((zone) => ({ label: zone.name === String(data.selected) ? 'Zone active' : 'Zone', title: zone.name, body: zone.role }));
if (variant === 'mvp') panels = [
  { label: 'Idée trop large', title: String(data.idea ?? ''), body: `Retirer : ${removed.join(', ')}` },
  { label: 'Objet testable', title: String(data.retained ?? ''), body: String(data.primaryAction ?? '') },
];
if (variant === 'tests') panels = [
  { label: 'Objet', title: String(data.objectTitle ?? 'Boîte de tri à six notes'), body: String(data.state ?? '') },
  ...tests.map((item) => ({ label: item.name, title: item.action, body: item.expected })),
  { label: 'Correction', title: 'Un écart précis', body: 'Modifier uniquement le comportement qui échoue.' },
];
if (variant === 'correction') panels = [
  { label: 'Itération 1', title: `✓ ${(iteration1.passing ?? []).join(', ')}`, body: `Échec : ${(iteration1.failing ?? []).join(', ')}` },
  { label: 'Correction ciblée', title: String(data.targetedChange ?? ''), body: String(data.evidence ?? '') },
  { label: 'Itération 2', title: `✓ ${(iteration2.passing ?? []).join(', ')}`, body: (iteration2.failing ?? []).length ? `Échec : ${iteration2.failing.join(', ')}` : 'Aucun test en échec' },
];
const loopCoordinates = panels.map((_, index) => {
  const angle = (-Math.PI / 2) + (index * 2 * Math.PI) / panels.length;
  return [280 + Math.cos(angle) * 185, 195 + Math.sin(angle) * 140];
});
const loopPath = 'M280 55 C430 55 475 115 475 195 C475 275 420 335 280 335 C140 335 85 275 85 195 C85 115 130 55 280 55 Z';
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="artifact-test-loop">
  <div class="artifact" data-artifact-loop data-variant={variant} data-enhanced="false" style={isLoopVariant ? `--artifact-panel-count: ${panels.length}` : undefined}>
    {variant === 'transfer' && (
      <section class="artifact__transfer" aria-label="Passage de la conversation à un objet autonome">
        <svg viewBox="0 0 760 300" role="img" aria-labelledby={`${slide.id}-transfer-title ${slide.id}-transfer-desc`}>
          <title id={`${slide.id}-transfer-title`}>La sortie devient un Artifact</title>
          <desc id={`${slide.id}-transfer-desc`}>Le bloc produit dans la conversation se déplace vers un objet autonome doté de quatre capacités.</desc>
          <path marker-end={`url(#${slide.id}-transfer-arrow)`} d="M245 150 C330 55 430 245 515 150" />
          <defs><marker id={`${slide.id}-transfer-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 Z" /></marker></defs>
          <rect x="35" y="55" width="210" height="190" rx="12" />
          <rect class="artifact__transfer-target" x="515" y="35" width="210" height="230" rx="12" />
          <text class="artifact__svg-kicker" x="60" y="87">AVANT · {before.location}</text>
          <text x="60" y="130">{beforeLines.map((line, index) => <tspan x="60" dy={index === 0 ? 0 : 24}>{line}</tspan>)}</text>
          <text class="artifact__svg-kicker" x="540" y="67">APRÈS · {after.location}</text>
          <text x="540" y="110">{afterLines.map((line, index) => <tspan x="540" dy={index === 0 ? 0 : 24}>{line}</tspan>)}</text>
          <text class="artifact__transfer-action" x="380" y="142" text-anchor="middle">EXTRAIRE</text>
        </svg>
        <ul>{affordances.map((affordance) => <li>{affordance}</li>)}</ul>
      </section>
    )}

    {variant === 'anatomy' && (
      <section class="artifact__anatomy" aria-label="Anatomie en trois zones de l’Artifact">
        <svg viewBox="0 0 780 300" role="img" aria-labelledby={`${slide.id}-anatomy-title ${slide.id}-anatomy-desc`}>
          <title id={`${slide.id}-anatomy-title`}>Conversation, objet et versions</title>
          <desc id={`${slide.id}-anatomy-desc`}>Trois zones reliées portent le brief, l’action testable et la mémoire des changements.</desc>
          <path d="M135 150 H645" />
          {zones.map((zone, index) => {
            const x = 135 + index * 255;
            const selected = zone.name === String(data.selected);
            return <g class:list={{ 'is-selected': selected }} transform={`translate(${x} 150)`}>
              <circle r="62" />
              <text class="artifact__svg-kicker" y="-10" text-anchor="middle">ZONE {index + 1}</text>
              <text y="18" text-anchor="middle">{zone.name}</text>
            </g>;
          })}
        </svg>
        <ol>{zones.map((zone) => <li class:list={{ 'is-selected': zone.name === String(data.selected) }}><strong>{zone.name}</strong><span>{zone.role}</span></li>)}</ol>
      </section>
    )}

    {variant === 'mvp' && (
      <section class="artifact__scope" aria-label="Réduction du périmètre vers une action testable">
        <div class="artifact__scope-idea"><span>Idée trop large</span><strong>{String(data.idea ?? '')}</strong><ul>{removed.map((item) => <li>{item}</li>)}</ul></div>
        <svg viewBox="0 0 240 180" role="img" aria-label="Le périmètre se resserre"><path d="M15 25 L220 82 L15 155" /><text x="118" y="98" text-anchor="middle">RÉDUIRE</text></svg>
        <div class="artifact__scope-core"><span>Objet testable</span><strong>{String(data.retained ?? '')}</strong><p>{String(data.primaryAction ?? '')}</p></div>
      </section>
    )}

    {isLoopVariant && (
      <>
        <section class="artifact__orbit">
          <svg viewBox="0 0 560 390" role="img" aria-labelledby={`${slide.id}-orbit-title ${slide.id}-orbit-desc`}>
            <title id={`${slide.id}-orbit-title`}>Boucle de test de l’Artifact</title>
            <desc id={`${slide.id}-orbit-desc`}>Chaque nœud de la boucle correspond au panneau de preuve portant le même nom.</desc>
            <path data-loop-path d={loopPath} />
            {loopCoordinates.map(([x,y], index) => (
              <g transform={`translate(${x} ${y})`} data-artifact-node={index}>
                <circle r="28" />
                <text y="5" text-anchor="middle">{String(index + 1).padStart(2, '0')}</text>
                <text class="artifact__orbit-label" y="48" text-anchor="middle">{panels[index]?.label}</text>
              </g>
            ))}
          </svg>
          <p class="artifact__rule"><span>Règle de boucle</span>Tester l’objet · nommer l’écart · corriger sans casser ce qui passe.</p>
        </section>

        <section class="artifact__inspection">
          <div class="artifact__stage-buttons" role="group" aria-label={String(data.interaction ?? 'Explorer les étapes')}>
            <button class="artifact__overview" type="button" disabled aria-pressed="true" data-artifact-overview>Vue d’ensemble</button>
            {panels.map((panel, index) => <button type="button" disabled aria-pressed="false" data-artifact-stage><span>{String(index + 1).padStart(2, '0')}</span>{panel.label}</button>)}
          </div>
          <div class="artifact__panels">
            {panels.map((panel) => (
              <article data-artifact-panel>
                <p>{panel.label}</p>
                <h3>{panel.title}</h3>
                <strong>{panel.body}</strong>
                {panel.note && <small>{panel.note}</small>}
              </article>
            ))}
          </div>
          <output data-artifact-status aria-live="polite">Vue d’ensemble · toutes les preuves sont visibles.</output>
        </section>
      </>
    )}
  </div>
</SceneFrame>

<script>
  import { artifactViewState } from './visual-state';
  import { onPresenterPage } from '../../../../scripts/on-presenter-page';

  onPresenterPage(() => {
    document.querySelectorAll<HTMLElement>('[data-artifact-loop]').forEach((scene) => {
      scene.dataset.enhanced = 'true';
      const buttons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-artifact-stage]'));
      const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-artifact-panel]'));
      const nodes = Array.from(scene.querySelectorAll<SVGGElement>('[data-artifact-node]'));
      const overview = scene.querySelector<HTMLButtonElement>('[data-artifact-overview]');
      const status = scene.querySelector<HTMLOutputElement>('[data-artifact-status]');
      if (!buttons.length || !panels.length) return;
      const render = (active: number | null) => {
        const state = artifactViewState(panels.length, active);
        scene.dataset.artifactView = state.active === null ? 'overview' : 'isolated';
        state.panels.forEach((visible, index) => { panels[index].hidden = !visible; });
        buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === state.active)));
        nodes.forEach((node, index) => {
          node.classList.toggle('is-active', state.active === index);
          node.classList.toggle('is-dimmed', !state.nodes[index]);
        });
        overview?.setAttribute('aria-pressed', String(state.active === null));
        if (status) status.textContent = state.active === null
          ? 'Vue d’ensemble · toutes les preuves sont visibles.'
          : `Étape ciblée : ${buttons[state.active]?.textContent?.trim() ?? ''}.`;
      };
      buttons.forEach((button, index) => { button.disabled = false; button.addEventListener('click', () => render(index)); });
      if (overview) {
        overview.disabled = false;
        overview.addEventListener('click', () => render(null));
      }
      render(null);
    });
  });
</script>

<style>
  .artifact { min-block-size: 0; min-inline-size: 0; }
  .artifact[data-variant='tests'], .artifact[data-variant='correction'] { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(.65rem, 1.5vw, 1.2rem); align-items: center; }
  .artifact__transfer, .artifact__anatomy { display: grid; grid-template-columns: minmax(22rem, 1.4fr) minmax(12rem, .6fr); gap: clamp(.8rem, 2vw, 1.7rem); align-items: center; }
  .artifact__transfer svg, .artifact__anatomy svg { inline-size: 100%; max-block-size: 17rem; overflow: visible; }
  .artifact__transfer > svg > path, .artifact__anatomy > svg > path { fill: none; stroke: var(--presentation-ink); stroke-width: 7; stroke-linecap: round; }
  .artifact__transfer marker path { fill: var(--presentation-ink); }
  .artifact__transfer rect { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; }
  .artifact__transfer .artifact__transfer-target { fill: color-mix(in srgb, var(--family-accent), white 76%); }
  /* Exception : texte SVG dimensionné dans le viewBox, pas dans le flux HTML. */
  .artifact__transfer text, .artifact__anatomy text, .artifact__scope text { fill: var(--presentation-ink); font: 740 17px var(--font-display); }
  .artifact__transfer .artifact__svg-kicker, .artifact__anatomy .artifact__svg-kicker { font: 700 14px var(--font-mono); }
  .artifact__transfer .artifact__transfer-action { font: 800 16px var(--font-mono); paint-order: stroke; stroke: var(--presentation-ivory); stroke-width: 10; stroke-linejoin: round; }
  .artifact__transfer ul, .artifact__anatomy ol { display: grid; margin: 0; padding: 0; list-style: none; }
  .artifact__transfer li { padding: .48rem .58rem; border-block-start: 1px solid var(--presentation-line); font: 750 var(--b-font-body) var(--font-display); }
  .artifact__transfer li::before { content: '◆'; margin-inline-end: .45rem; color: var(--family-accent); }
  .artifact__anatomy circle { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; }
  .artifact__anatomy g.is-selected circle { fill: var(--family-accent); }
  .artifact__anatomy li { display: grid; gap: .12rem; padding: .45rem .6rem; border-block-start: 1px solid var(--presentation-line); }
  .artifact__anatomy li.is-selected { border-block-start-width: .3rem; border-color: var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 86%); }
  .artifact__anatomy li strong { font: 750 .75rem var(--font-display); }
  .artifact__anatomy li span { font-size: var(--b-font-body); }
  .artifact__scope { display: grid; grid-template-columns: minmax(13rem, .85fr) minmax(8rem, .35fr) minmax(15rem, 1fr); gap: clamp(.7rem, 2vw, 1.5rem); align-items: center; }
  .artifact__scope > div { display: grid; gap: .35rem; min-block-size: 9.5rem; padding: .65rem; border: 2px solid var(--presentation-ink); align-content: center; }
  .artifact__scope span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .artifact__scope strong { font: 780 clamp(1rem, 2vw, 1.45rem)/1.05 var(--font-display); }
  .artifact__scope ul { display: grid; grid-template-columns: 1fr 1fr; gap: .28rem; margin: 0; padding: 0; list-style: none; }
  .artifact__scope li { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-decoration: line-through; }
  .artifact__scope svg { inline-size: 100%; overflow: visible; }
  .artifact__scope svg path { fill: color-mix(in srgb, var(--family-accent), transparent 65%); stroke: var(--presentation-ink); stroke-width: 3; stroke-linejoin: round; }
  .artifact__scope-core { border-block-start-width: .65rem !important; border-block-start-color: var(--family-accent) !important; }
  .artifact__scope-core p { margin: 0; font: 730 .76rem var(--font-display); }
  .artifact__orbit { display: grid; grid-template-columns: 1fr; gap: .45rem; align-items: center; justify-items: center; }
  .artifact__orbit svg { inline-size: 100%; max-block-size: 16.5rem; overflow: visible; }
  .artifact__orbit path { fill: none; stroke: var(--presentation-ink); stroke-width: 5; stroke-linecap: round; }
  .artifact__orbit circle { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; transition: fill 160ms ease, opacity 160ms ease; }
  .artifact__orbit g.is-active circle { fill: var(--family-accent); }
  .artifact__orbit g.is-dimmed { opacity: .28; }
  .artifact__orbit text { fill: var(--presentation-ink); font: 700 21px var(--font-mono); }
  .artifact__orbit .artifact__orbit-label { font: 750 21px var(--font-display); }
  .artifact__rule { display: grid; gap: .2rem; margin: 0; padding-inline-start: .6rem; border-inline-start: .3rem solid var(--family-accent); font: 720 var(--b-font-body)/1.16 var(--font-display); }
  .artifact__rule span { color: var(--presentation-muted); font: 600 var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .artifact__inspection { display: grid; gap: .18rem; min-block-size: 0; min-inline-size: 0; }
  .artifact__stage-buttons { display: grid; grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr)); align-content: center; }
  .artifact__stage-buttons button { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .12rem .4rem; min-block-size: 2rem; min-inline-size: 0; padding: .14rem .22rem; overflow-wrap: anywhere; border: 0; border-block-start: 1px solid var(--presentation-line); background: transparent; color: var(--presentation-ink); font: 710 var(--b-font-control) var(--font-display); text-align: start; cursor: pointer; }
  .artifact__stage-buttons .artifact__overview { grid-column: auto; display: block; min-block-size: 1.8rem; text-align: center; }
  .artifact__stage-buttons button[aria-pressed='true'] { border-block-start-width: .28rem; border-color: var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 86%); }
  .artifact__stage-buttons button:disabled { cursor: default; }
  .artifact__stage-buttons span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .artifact__panels { display: grid; grid-template-columns: repeat(var(--artifact-panel-count), minmax(0, 1fr)); gap: .25rem; min-inline-size: 0; align-content: center; }
  [data-enhanced='true'][data-artifact-view='isolated'] .artifact__panels { grid-template-columns: 1fr; }
  .artifact__panels article { display: grid; gap: .08rem; align-content: center; min-block-size: 0; min-inline-size: 0; padding: .25rem .3rem; overflow-wrap: anywhere; border: 1px solid var(--presentation-line); border-block-start: .25rem solid var(--family-accent); background: var(--presentation-surface); }
  .artifact__panels article p, .artifact__panels article h3, .artifact__panels article strong { margin: 0; }
  .artifact__panels article p { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .artifact__panels article h3 { font: 750 clamp(.82rem, .9vw, .92rem)/1.05 var(--font-display); }
  .artifact__panels article strong { font-size: var(--b-font-body); line-height: 1.1; }
  .artifact__panels article small { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .artifact__inspection output { color: var(--presentation-muted); font: var(--b-font-control) var(--font-mono); }
  [data-artifact-panel][hidden] { display: none !important; }
  button:focus-visible { outline: .22rem solid var(--presentation-focus); outline-offset: .18rem; }
  @container (max-width: 50rem) {
    .artifact[data-variant='tests'], .artifact[data-variant='correction'], .artifact__transfer, .artifact__anatomy, .artifact__scope { grid-template-columns: 1fr; }
    .artifact__orbit { grid-template-columns: 1fr; }
    .artifact__orbit svg { max-block-size: 11rem; }
    .artifact__inspection { grid-template-columns: 1fr; }
    .artifact__stage-buttons { grid-template-columns: repeat(3, 1fr); }
    .artifact__panels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .artifact * { transition: none !important; animation: none !important; } }
</style>
