---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getPromptVariant } from './visual-state';

interface Props { slide: RoutedSlide; }
interface NamedBlock { name: string; question: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getPromptVariant(data);
const sourceBlocks = (Array.isArray(data.blocks) ? data.blocks : []) as NamedBlock[];
const assumptions = Array.isArray(data.assumptions) ? data.assumptions.map(String) : [];
const preview = Array.isArray(data.preview) ? data.preview.map(String) : [];
const loop = Array.isArray(data.loop) ? data.loop.map(String) : [];
const promptBlocks = variant === 'blocks'
  ? sourceBlocks.map((block) => ({ name: block.name, content: block.question }))
  : variant === 'comparison'
    ? ['Objectif', 'Contexte', 'Contraintes', 'Forme'].map((name, index) => ({ name, content: assumptions[index] ?? name }))
    : [
      { name: 'Objectif', content: String(data.objective ?? '') },
      { name: 'Contexte', content: String(data.context ?? '') },
      { name: 'Contraintes', content: Array.isArray(data.constraints) ? data.constraints.map(String).join(', ') : '' },
      { name: 'Forme', content: String(data.form ?? '') },
    ];
const staticResult = variant === 'comparison' ? String(data.after ?? '') : promptBlocks.map((block) => `${block.name} : ${block.content}`).join(' · ');
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="prompt-builder">
  <div class="prompt" data-prompt-builder data-variant={variant} data-enhanced="false">
    {variant !== 'loop' && (
      <section class="prompt__construction">
        {variant === 'comparison' && <blockquote><span>Demande initiale</span>{String(data.before ?? '')}</blockquote>}
        <div class="prompt__blocks" role="group" aria-label={String(data.interaction ?? 'Assembler le brief')}>
          {promptBlocks.map((block, index) => (
            <button type="button" disabled aria-pressed="true" data-prompt-block data-content={block.content} data-name={block.name}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{block.name}</strong>
              <small>{block.content}</small>
              <i aria-hidden="true">＋</i>
            </button>
          ))}
        </div>
        <div class="prompt__join" aria-hidden="true"><span></span><b>Brief assemblé</b><span></span></div>
        <output class="prompt__result" data-prompt-result data-prompt-target={staticResult} aria-live="polite">{staticResult}</output>
        {variant === 'comparison' && <p class="prompt__relation-status" data-prompt-relation-status aria-live="polite">Le brief final répond aux quatre ambiguïtés rendues visibles.</p>}
        {variant === 'builder' && <ol class="prompt__preview" aria-label="Aperçu du résultat">{preview.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}</ol>}
      </section>
    )}

    {variant === 'loop' && (
      <section class="prompt__loop">
        <svg viewBox="0 0 940 250" role="img" aria-labelledby={`${slide.id}-loop-title ${slide.id}-loop-desc`}>
          <title id={`${slide.id}-loop-title`}>Boucle d’amélioration du prompt</title>
          <desc id={`${slide.id}-loop-desc`}>Le prompt mène à une réponse, puis à un écart, une correction ciblée et une preuve d’amélioration qui nourrit le prompt suivant.</desc>
          <path d="M105 125 C105 34 835 34 835 125 C835 216 105 216 105 125 Z" />
          {loop.map((item, index) => {
            const positions = [[105,125],[280,54],[510,54],[735,75],[690,196]];
            const [x, y] = positions[index] ?? [105 + index * 160, 125];
            return <g transform={`translate(${x} ${y})`}><circle r="25" /><text y="5" text-anchor="middle">{index + 1}</text><text class="prompt__loop-label" y="46" text-anchor="middle">{item}</text></g>;
          })}
        </svg>
        <div class="prompt__loop-proof">
          <p><span>Écart</span>{String(data.exampleGap ?? '')}</p>
          <p><span>Correction ciblée</span>{String(data.correction ?? '')}</p>
          <p><span>Preuve</span><strong>{String(data.proof ?? '')}</strong></p>
        </div>
      </section>
    )}
  </div>
</SceneFrame>

<script>
  import { promptOutputForVariant } from './visual-state';

  document.querySelectorAll<HTMLElement>('[data-prompt-builder]').forEach((scene) => {
    scene.dataset.enhanced = 'true';
    const blocks = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-prompt-block]'));
    const result = scene.querySelector<HTMLOutputElement>('[data-prompt-result]');
    const relationStatus = scene.querySelector<HTMLElement>('[data-prompt-relation-status]');
    if (!blocks.length || !result) return;
    const variant = scene.dataset.variant === 'comparison' ? 'comparison' : scene.dataset.variant === 'blocks' ? 'blocks' : 'builder';
    const target = result.dataset.promptTarget ?? result.textContent ?? '';
    const active = blocks.map(() => variant === 'comparison');
    const render = () => {
      blocks.forEach((block, index) => block.setAttribute('aria-pressed', String(active[index])));
      result.textContent = promptOutputForVariant(variant, target, blocks.map((block) => block.dataset.content ?? ''), active);
      if (relationStatus) {
        const selected = blocks.filter((_, index) => active[index]).map((block) => block.dataset.name ?? '');
        relationStatus.textContent = selected.length
          ? `Ambiguïtés reliées au brief final : ${selected.join(', ')}.`
          : 'Le brief final reste la cible ; aucune ambiguïté n’est isolée.';
      }
    };
    blocks.forEach((block, index) => {
      block.disabled = false;
      block.addEventListener('click', () => { active[index] = !active[index]; render(); });
    });
    render();
  });
</script>

<style>
  .prompt { min-block-size: 0; }
  .prompt__construction { display: grid; grid-template-columns: minmax(10rem, .32fr) 1fr; gap: .55rem 1.15rem; align-content: center; }
  .prompt__construction > blockquote { grid-row: 1 / 4; align-self: center; display: grid; gap: .3rem; margin: 0; padding: .8rem; border-inline-start: .35rem solid #ed6a46; font: 750 clamp(1rem, 2vw, 1.45rem)/1.05 var(--font-display); }
  .prompt__construction > blockquote span { color: var(--presentation-muted); font: 600 var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .prompt__blocks { display: grid; grid-template-columns: repeat(4, 1fr); gap: .45rem; }
  .prompt__blocks button { position: relative; display: grid; grid-template-columns: auto 1fr; gap: .1rem .35rem; min-block-size: 6rem; padding: .45rem .42rem .38rem; border: 1px solid var(--presentation-ink); border-block-start: .4rem solid var(--family-accent); background: var(--presentation-surface); color: var(--presentation-ink); text-align: start; cursor: pointer; box-shadow: .28rem .28rem 0 color-mix(in srgb, var(--family-accent), transparent 35%); transition: transform 150ms ease, box-shadow 150ms ease, opacity 150ms ease; }
  .prompt__blocks button:nth-child(2) { border-block-start-color: #72af80; }
  .prompt__blocks button:nth-child(3) { border-block-start-color: #ed6a46; }
  .prompt__blocks button:nth-child(4) { border-block-start-color: #b79bca; }
  .prompt__blocks button:not([aria-pressed='true']) { opacity: .48; box-shadow: none; transform: translate(.2rem, .2rem); }
  .prompt__blocks button:disabled { cursor: default; opacity: 1; }
  .prompt__blocks button > span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .prompt__blocks strong { font: 760 .83rem var(--font-display); }
  .prompt__blocks small { grid-column: 1 / -1; font-size: var(--b-font-body); font-style: normal; line-height: 1.1; }
  .prompt__blocks i { position: absolute; inset-block-end: .22rem; inset-inline-end: .32rem; font: 700 1rem var(--font-mono); }
  .prompt__join { display: grid; grid-template-columns: 1fr auto 1fr; gap: .45rem; align-items: center; color: var(--presentation-muted); font: 600 var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .prompt__join span { block-size: 1px; background: var(--presentation-line); }
  .prompt__result { display: block; min-block-size: 3rem; padding: .55rem .7rem; border: 1px solid var(--presentation-ink); background: color-mix(in srgb, var(--family-accent), var(--presentation-surface) 88%); font: 720 clamp(var(--b-font-body), 1.2vw, .9rem)/1.22 var(--font-display); }
  .prompt__relation-status { grid-column: 2; margin: -.15rem 0 0; color: var(--presentation-muted); font: var(--b-font-control)/1.15 var(--font-mono); }
  .prompt__preview { grid-column: 2; display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; list-style: none; }
  .prompt__preview li { display: grid; gap: .08rem; padding: .25rem; border-inline-start: 1px solid var(--presentation-line); font-size: var(--b-font-body); font-weight: 700; }
  .prompt__preview li span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .prompt__loop { display: grid; grid-template-columns: 1.25fr minmax(13rem, .75fr); gap: 1rem; align-items: center; }
  .prompt__loop svg { inline-size: 100%; overflow: visible; }
  .prompt__loop path { fill: none; stroke: var(--presentation-ink); stroke-width: 5; stroke-linecap: round; }
  .prompt__loop circle { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; }
  .prompt__loop g:last-of-type circle { fill: var(--family-accent); }
  /* Exception : texte SVG dimensionné dans le viewBox, pas dans le flux HTML. */
  .prompt__loop text { fill: var(--presentation-ink); font: 700 14px var(--font-mono); }
  .prompt__loop .prompt__loop-label { font: 700 14px var(--font-display); }
  .prompt__loop-proof { display: grid; gap: .5rem; }
  .prompt__loop-proof p { display: grid; gap: .1rem; margin: 0; padding: .42rem .55rem; border-block-start: 1px solid var(--presentation-line); font-size: var(--b-font-body); line-height: 1.14; }
  .prompt__loop-proof span { color: var(--presentation-muted); font: 600 var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .prompt__loop-proof strong { font: 760 .9rem var(--font-display); }
  button:focus-visible { outline: .22rem solid var(--presentation-focus); outline-offset: .18rem; }
  @media (max-width: 48rem) {
    .prompt__construction, .prompt__loop { grid-template-columns: 1fr; }
    .prompt__construction > blockquote { grid-row: auto; }
    .prompt__blocks { grid-template-columns: 1fr 1fr; }
    .prompt__blocks button { box-shadow: inset 0 -.2rem 0 color-mix(in srgb, var(--family-accent), transparent 35%); }
    .prompt__blocks button:not([aria-pressed='true']) { transform: none; }
    .prompt__preview { grid-column: 1; }
    .prompt__relation-status { grid-column: 1; }
  }
  @media (max-width: 32rem) { .prompt__preview { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .prompt__blocks button { transition: none; } }
</style>
