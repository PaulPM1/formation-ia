---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getWorkspaceVariant, workspaceSharedPath } from './visual-state';

interface Props { slide: RoutedSlide; }
interface Pane { name: string; role?: string; evidence?: string; }
interface CommandItem { shell: string; command: string; expectedSuffix: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getWorkspaceVariant(data);
const sharedPath = workspaceSharedPath(data);
const normalizedSharedPath = sharedPath.replaceAll('\\', '/').replace(/\/$/, '');
const folderLabel = normalizedSharedPath.split('/').filter(Boolean).at(-1) ?? normalizedSharedPath;
const fileLabel = 'brief.test.mjs';
const destination = typeof data.destination === 'string' ? data.destination : '';
const panes = (Array.isArray(data.panes) ? data.panes : []) as Pane[];
const contents = Array.isArray(data.contents) ? data.contents.map(String) : [];
const commands = (Array.isArray(data.commands) ? data.commands : []) as CommandItem[];
const commandObject = (data.command ?? {}) as { mac?: string; windows?: string };
const macCommand = variant === 'path'
  ? commands.find((item) => /macOS|Git Bash/i.test(item.shell))?.command ?? 'pwd'
  : commandObject.mac ?? 'code atelier-ia';
const windowsCommand = variant === 'path'
  ? commands.find((item) => /Windows/i.test(item.shell))?.command ?? 'Get-Location'
  : commandObject.windows ?? 'code atelier-ia';
const macExpected = commands.find((item) => /macOS|Git Bash/i.test(item.shell))?.expectedSuffix ?? `/${String(data.folder ?? 'atelier-ia')}`;
const windowsExpected = commands.find((item) => /Windows/i.test(item.shell))?.expectedSuffix ?? `\\${String(data.folder ?? 'atelier-ia')}`;
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="workspace-triptych">
  <div class="triptych" data-workspace-triptych data-variant={variant} data-enhanced="false">
    <section class="triptych__workspace" aria-label="Explorateur, éditeur et terminal reliés au même dossier">
      <svg viewBox="0 0 900 350" role="img" aria-labelledby={`${slide.id}-triptych-title ${slide.id}-triptych-desc`}>
        <title id={`${slide.id}-triptych-title`}>Les trois vues d’un même workspace</title>
        <desc id={`${slide.id}-triptych-desc`}>Un chemin continu relie le fichier dans l’Explorateur, son contenu dans l’Éditeur et le dossier courant dans le Terminal.</desc>
        <path d="M155 175 H450 V278 H745" />
        <rect x="35" y="55" width="240" height="240" rx="10" />
        <rect x="330" y="55" width="240" height="240" rx="10" />
        <rect x="625" y="55" width="240" height="240" rx="10" />
        <g data-triptych-node="0"><circle cx="155" cy="175" r="24" /><text x="155" y="181" text-anchor="middle">1</text></g>
        <g data-triptych-node="1"><circle cx="450" cy="175" r="24" /><text x="450" y="181" text-anchor="middle">2</text></g>
        <g data-triptych-node="2"><circle cx="745" cy="278" r="24" /><text x="745" y="284" text-anchor="middle">3</text></g>
        <text class="triptych__pane-title" x="55" y="87">EXPLORATEUR</text>
        <text x="58" y="125">▾ {folderLabel}</text><text x="78" y="153">{fileLabel}</text>
        <text class="triptych__pane-title" x="350" y="87">ÉDITEUR</text>
        <text x="350" y="125">{fileLabel}</text><text x="350" y="153">test.todo("source")</text>
        <text class="triptych__pane-title" x="645" y="87">TERMINAL</text>
        <text x="645" y="125">$ node --test</text><text x="645" y="153">…/{folderLabel}</text>
      </svg>
      <div class="triptych__context-labels">
        <p class="triptych__shared"><span>Chemin partagé</span>{sharedPath}</p>
        {destination && <p class="triptych__destination"><span>Transition suivante</span>{destination}</p>}
      </div>
    </section>

    <section class="triptych__detail">
      {variant === 'panes' && (
        <div class="triptych__panes">
          <div class="triptych__pane-buttons" role="group" aria-label={String(data.interaction ?? 'Mettre en évidence chaque zone')}>{panes.map((pane, index) => <button type="button" disabled aria-pressed={index === 0 ? 'true' : 'false'} data-pane-button><span>{String(index + 1).padStart(2, '0')}</span>{pane.name}</button>)}</div>
          <div class="triptych__pane-panels">{panes.map((pane) => <article data-pane-panel><p>{pane.name}</p><strong>{pane.role ?? pane.evidence}</strong></article>)}</div>
        </div>
      )}

      {variant === 'workspace' && (
        <div class="triptych__open">
          <div class="triptych__folder"><span>Dossier</span><strong>{String(data.folder ?? '')}</strong>{contents.map((item) => <code>└─ {item}</code>)}</div>
          <div class="triptych__platforms" role="group" aria-label="Choisir la plateforme"><button type="button" disabled aria-pressed="true" data-platform-button="mac">macOS</button><button type="button" disabled aria-pressed="false" data-platform-button="windows">Windows</button></div>
          <div class="triptych__commands-static"><p><span>macOS</span><code data-command-mac>{macCommand}</code></p><p><span>Windows</span><code data-command-windows>{windowsCommand}</code></p></div>
          <output class="triptych__command-output" data-command-output aria-live="polite">{macCommand}</output>
          <p class="triptych__trust">Workspace fiable · {String(data.trustRule ?? '')}</p>
        </div>
      )}

      {variant === 'path' && (
        <div class="triptych__path">
          <p class="triptych__explorer-path"><span>Explorateur</span>{String(data.explorerPath ?? '')}</p>
          <div class="triptych__platforms" role="group" aria-label="Choisir le système"><button type="button" disabled aria-pressed="true" data-platform-button="mac">macOS / Git Bash</button><button type="button" disabled aria-pressed="false" data-platform-button="windows">Windows</button></div>
          <div class="triptych__commands-static"><p><span>macOS / Git Bash</span><code data-command-mac>{macCommand}</code><small>{macExpected}</small></p><p><span>Windows</span><code data-command-windows>{windowsCommand}</code><small>{windowsExpected}</small></p></div>
          <div class="triptych__terminal-result"><code data-command-output>{macCommand}</code><strong data-expected-output>{macExpected}</strong></div>
          <p class="triptych__mismatch">Si les chemins diffèrent · {String(data.mismatchAction ?? '')}</p>
        </div>
      )}
    </section>
  </div>
</SceneFrame>

<script>
  import { resolvePanelVisibility } from './visual-state';
  import { onPresenterPage } from '../../../../scripts/on-presenter-page';

  onPresenterPage(() => {
    document.querySelectorAll<HTMLElement>('[data-workspace-triptych]').forEach((scene) => {
      scene.dataset.enhanced = 'true';
      const paneButtons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-pane-button]'));
      const panePanels = Array.from(scene.querySelectorAll<HTMLElement>('[data-pane-panel]'));
      const nodes = Array.from(scene.querySelectorAll<SVGGElement>('[data-triptych-node]'));
      if (paneButtons.length && panePanels.length) {
        const renderPane = (active: number) => {
          resolvePanelVisibility(panePanels.length, active, true).forEach((visible, index) => { panePanels[index].hidden = !visible; });
          paneButtons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === active)));
          nodes.forEach((node, index) => node.classList.toggle('is-active', index === active));
        };
        paneButtons.forEach((button, index) => { button.disabled = false; button.addEventListener('click', () => renderPane(index)); });
        renderPane(0);
      }

      const platformButtons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-platform-button]'));
      const commandOutput = scene.querySelector<HTMLElement>('[data-command-output]');
      const expectedOutput = scene.querySelector<HTMLElement>('[data-expected-output]');
      const mac = scene.querySelector<HTMLElement>('[data-command-mac]')?.textContent?.trim() ?? '';
      const windows = scene.querySelector<HTMLElement>('[data-command-windows]')?.textContent?.trim() ?? '';
      const staticCommands = scene.querySelector<HTMLElement>('.triptych__commands-static');
      if (!platformButtons.length || !commandOutput) return;
      const expected = { mac: '/atelier-ia', windows: '\\atelier-ia' };
      if (expectedOutput) {
        const values = Array.from(scene.querySelectorAll<HTMLElement>('.triptych__commands-static small')).map((item) => item.textContent?.trim() ?? '');
        expected.mac = values[0] || expected.mac;
        expected.windows = values[1] || expected.windows;
      }
      const renderPlatform = (platform: 'mac' | 'windows') => {
        commandOutput.textContent = platform === 'mac' ? mac : windows;
        if (expectedOutput) expectedOutput.textContent = expected[platform];
        platformButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.platformButton === platform)));
      };
      platformButtons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => renderPlatform(button.dataset.platformButton === 'windows' ? 'windows' : 'mac'));
      });
      if (staticCommands) staticCommands.hidden = true;
      renderPlatform('mac');
    });
  });
</script>

<style>
  .triptych { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(.8rem, 2vw, 1.7rem); align-items: center; min-block-size: 0; min-inline-size: 0; }
  .triptych__workspace { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .28fr); gap: .35rem; min-inline-size: 0; align-items: center; }
  .triptych__detail { min-inline-size: 0; overflow-wrap: anywhere; }
  .triptych__workspace svg { inline-size: 100%; max-block-size: 14rem; overflow: visible; }
  .triptych__workspace path { fill: none; stroke: var(--family-accent); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .triptych__workspace rect { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 3; }
  .triptych__workspace circle { fill: var(--presentation-surface); stroke: var(--presentation-ink); stroke-width: 4; transition: fill 160ms ease; }
  .triptych__workspace g:first-of-type circle, .triptych__workspace g.is-active circle { fill: var(--family-accent); }
  /* Exception : texte SVG dimensionné dans le viewBox, pas dans le flux HTML. */
  .triptych__workspace text { fill: var(--presentation-ink); font: 650 18px var(--font-mono); }
  .triptych__workspace g text { font: 800 21px var(--font-display); }
  .triptych__workspace .triptych__pane-title { font: 760 20px var(--font-display); }
  .triptych__context-labels { display: grid; gap: .5rem; }
  .triptych__shared, .triptych__destination { display: grid; gap: .18rem; margin: 0; padding-inline-start: .65rem; border-inline-start: .3rem solid var(--family-accent); font: 750 var(--b-font-body)/1.1 var(--font-display); overflow-wrap: anywhere; }
  .triptych__destination { border-color: #ed6a46; }
  .triptych__shared span, .triptych__destination span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .triptych__panes { display: grid; grid-template-columns: minmax(7rem, .42fr) 1fr; gap: .55rem; }
  .triptych__pane-buttons { display: grid; align-content: center; }
  .triptych__pane-buttons button { display: grid; grid-template-columns: 1.4rem 1fr; gap: .3rem; min-block-size: 2.6rem; padding: .3rem; border: 0; border-block-start: 1px solid var(--presentation-line); background: transparent; color: var(--presentation-ink); font: 720 var(--b-font-control) var(--font-display); text-align: start; cursor: pointer; }
  .triptych__pane-buttons button[aria-pressed='true'] { border-block-start-width: .3rem; border-color: var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 86%); }
  .triptych__pane-buttons span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .triptych__pane-panels { display: grid; gap: .4rem; }
  .triptych__pane-panels article { display: grid; gap: .2rem; min-block-size: 4.5rem; padding: .55rem .65rem; border: 1px solid var(--presentation-line); border-block-start: .3rem solid var(--family-accent); background: var(--presentation-surface); }
  .triptych__pane-panels p { margin: 0; color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .triptych__pane-panels strong { font: 740 .78rem/1.15 var(--font-display); }
  .triptych__open, .triptych__path { display: grid; gap: .5rem; }
  .triptych__folder { display: grid; gap: .15rem; padding: .6rem; border-inline-start: .35rem solid var(--family-accent); }
  .triptych__folder span, .triptych__explorer-path span { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); text-transform: uppercase; }
  .triptych__folder strong { font: 760 1.1rem var(--font-display); }
  .triptych__folder code { font-size: 0.82rem; }
  .triptych__platforms { display: grid; grid-template-columns: 1fr 1fr; gap: .3rem; }
  .triptych__platforms button { min-block-size: 2.5rem; padding: .3rem; border: 1px solid var(--presentation-ink); background: var(--presentation-surface); color: var(--presentation-ink); font: 700 var(--b-font-control) var(--font-display); cursor: pointer; }
  .triptych__platforms button[aria-pressed='true'] { background: var(--family-accent); box-shadow: inset 0 -.25rem 0 var(--presentation-ink); }
  .triptych__commands-static { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem; }
  .triptych__commands-static p { display: grid; gap: .2rem; margin: 0; padding: .45rem; border: 1px solid var(--presentation-line); }
  .triptych__commands-static span, .triptych__commands-static small { color: var(--presentation-muted); font: var(--b-font-meta) var(--font-mono); }
  .triptych__command-output, .triptych__terminal-result { display: block; padding: .65rem .75rem; border: 1px solid var(--presentation-ink); background: var(--presentation-ink); color: var(--presentation-surface); font: 700 .82rem var(--font-mono); }
  .triptych__trust, .triptych__mismatch { margin: 0; padding-inline-start: .55rem; border-inline-start: .3rem solid #72af80; font-size: var(--b-font-body); font-weight: 720; }
  .triptych__explorer-path { display: grid; gap: .15rem; margin: 0; padding: .5rem .6rem; border-inline-start: .35rem solid var(--family-accent); font: 760 .9rem var(--font-display); }
  .triptych__terminal-result { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .triptych__terminal-result strong { color: var(--family-accent); }
  [data-pane-panel][hidden], .triptych__commands-static[hidden] { display: none !important; }
  button:focus-visible { outline: .22rem solid var(--presentation-focus); outline-offset: .18rem; }
  @media (max-width: 52rem) {
    .triptych { grid-template-columns: 1fr; }
    .triptych__workspace { grid-template-columns: 1fr; }
    .triptych__workspace svg { max-block-size: 11rem; }
  }
  @media (max-width: 34rem) { .triptych__panes { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .triptych__workspace circle { transition: none; } }
</style>
