---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';

interface ContextOption {
  label: string;
  leadIn: string;
  interpretation: string;
  completion: string;
}

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
const contexts = Array.isArray(data.contexts) ? data.contexts as ContextOption[] : [];
const laneId = `${slide.id}-prediction-lane`;
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class="context-comparison"
>
  <div class="context-comparison__scene" data-context-comparison>
    <div class="context-comparison__source">
      <p class="scene-label">Même amorce</p>
      <blockquote>{String(data.sharedPrompt ?? slide.claim)}</blockquote>
      <div class="context-comparison__switch" aria-label={String(data.interaction ?? 'Choisir un contexte')}>
        {contexts.map((context, index) => (
          <button
            type="button"
            disabled
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-controls={`${laneId}-${index}`}
            data-context-option={index}
          >
            <span aria-hidden="true">{index === 0 ? '●' : '◆'}</span>
            {context.label}
          </button>
        ))}
      </div>
    </div>

    <div class="context-comparison__connector" aria-hidden="true">
      <span></span>
    </div>

    <div class="context-comparison__lanes" aria-live="polite">
      {contexts.map((context, index) => (
        <section id={`${laneId}-${index}`} class="context-comparison__lane" data-context-panel={index}>
          <p class="scene-label">Contexte précédent</p>
          <p class="context-comparison__lead-in">{context.leadIn}</p>
          <p class="context-comparison__meaning">
            <span>Interprétation</span>
            <strong>{context.interpretation}</strong>
          </p>
          <p class="context-comparison__prediction">
            <span>{String(data.sharedPrompt ?? '')}</span>
            <mark>{context.completion}</mark>
          </p>
        </section>
      ))}
    </div>

    <p class="context-comparison__observation">
      <span aria-hidden="true">↳</span>{String(data.observation ?? 'Le contexte infléchit la réponse.')}
    </p>

  </div>
</SceneFrame>

<script>
  import { onPresenterPage } from '../../../../scripts/on-presenter-page';

  onPresenterPage(() => {
    document.querySelectorAll<HTMLElement>('[data-context-comparison]').forEach((scene) => {
      const buttons = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-context-option]'));
      const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-context-panel]'));
      scene.dataset.enhanced = 'true';

      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          panels.forEach((panel) => { panel.hidden = panel.dataset.contextPanel !== button.dataset.contextOption; });
        });
      });
      panels.forEach((panel, index) => { panel.hidden = index !== 0; });
    });
  });
</script>

<style>
  .context-comparison__scene {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) clamp(3rem, 7vw, 7rem) minmax(18rem, 1.2fr);
    grid-template-rows: 1fr auto;
    gap: 0.8rem 0;
    align-items: center;
    min-block-size: 100%;
  }

  .context-comparison__source,
  .context-comparison__lane {
    display: grid;
    gap: 0.7rem;
    align-content: center;
    min-inline-size: 0;
  }

  .context-comparison__lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem;
    min-inline-size: 0;
  }
  [data-enhanced='true'] .context-comparison__lanes { grid-template-columns: 1fr; }
  .context-comparison__lane[hidden] { display: none; }

  .context-comparison__source blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1vw, 2.35rem);
    font-weight: 720;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .context-comparison__switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .context-comparison__switch button {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.45rem;
    align-items: center;
    min-block-size: 3rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--presentation-ink);
    border-radius: 0.2rem;
    background: transparent;
    color: var(--presentation-ink);
    font-size: clamp(0.78rem, 0.75rem + 0.16vw, 0.9rem);
    font-weight: 680;
    text-align: start;
  }

  .context-comparison__switch button[aria-pressed='true'] {
    border-block-end-width: 0.35rem;
    background: var(--family-accent);
  }

  .context-comparison__connector {
    position: relative;
    inline-size: 100%;
    block-size: 0.25rem;
    background: var(--family-accent);
  }

  .context-comparison__connector::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    inline-size: 0.85rem;
    block-size: 0.85rem;
    border-block-start: 0.25rem solid var(--family-accent);
    border-inline-end: 0.25rem solid var(--family-accent);
    content: '';
    transform: translateY(-50%) rotate(45deg);
  }

  .context-comparison__lane {
    display: grid;
    gap: .65rem;
    align-content: center;
    min-inline-size: 0;
    padding: clamp(.8rem, 1.8vw, 1.4rem);
    border-inline-start: .35rem solid var(--family-accent);
    background: color-mix(in srgb, var(--family-accent), transparent 86%);
  }

  .context-comparison__lead-in {
    margin: 0;
    font-size: clamp(.95rem, .88rem + .25vw, 1.1rem);
  }

  .context-comparison__meaning {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .5rem;
    margin: 0;
    padding-block: .45rem;
    border-block: 1px solid var(--presentation-line);
  }

  .context-comparison__meaning span {
    color: var(--presentation-muted);
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
  }

  .context-comparison__prediction {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    align-items: baseline;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + .5vw, 1.55rem);
    font-weight: 720;
  }

  .context-comparison__prediction mark {
    padding: .08em .2em;
    background: var(--family-accent);
    color: var(--presentation-ink);
  }

  .context-comparison__observation {
    display: flex;
    grid-column: 1 / -1;
    gap: 0.6rem;
    justify-self: center;
    margin: 0;
    font-weight: 750;
  }

  .context-comparison__observation span { color: color-mix(in srgb, var(--family-accent), var(--presentation-ink) 35%); }

  @media (max-width: 52rem) {
    .context-comparison__scene { grid-template-columns: 1fr; grid-template-rows: auto; }
    .context-comparison__lanes { grid-template-columns: 1fr; }
    .context-comparison__meaning { grid-template-columns: 1fr; }
    .context-comparison__connector { inline-size: 0.25rem; block-size: 2.4rem; margin-inline: auto; }
    .context-comparison__connector::after { inset-block-start: auto; inset-block-end: 0; inset-inline-end: 50%; transform: translateX(50%) rotate(135deg); }
  }
</style>
