---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';

interface Candidate {
  token: string;
  plausibility: string;
}

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
const example = Array.isArray(data.example) ? data.example.map(String) : [];
const candidates = Array.isArray(data.candidates) ? data.candidates as Candidate[] : [];
const prompt = typeof data.prompt === 'string' ? data.prompt : '';
const tokens = example.length > 0
  ? example
  : [prompt, candidates[0]?.token ? ` ${candidates[0].token}` : ''];
const cleanTokens = tokens.filter(Boolean);
const fullSentence = cleanTokens.join('');
const loop = Array.isArray(data.loop) ? data.loop.map(String) : [];
const descriptionId = `${slide.id}-token-description`;
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class="token-predictor"
>
  <div
    class="token-predictor__scene"
    data-token-predictor
    data-tokens={JSON.stringify(cleanTokens)}
  >
    <p id={descriptionId} class="visually-hidden">
      Phrase complète : {fullSentence}. {slide.accessibleDescription}
    </p>

    <div class="token-predictor__assembly" aria-describedby={descriptionId}>
      <p class="scene-label">Contexte enrichi</p>
      <p class="token-predictor__sentence" aria-hidden="true">
        {cleanTokens.map((token, index) => (
          <span data-token data-token-index={index}>{token}</span>
        ))}
        <span class="token-predictor__cursor" aria-hidden="true"></span>
      </p>
      <output class="token-predictor__status" data-token-status aria-live="polite">
        Phrase complète · {cleanTokens.length} fragments
      </output>
      <button
        class="token-predictor__advance"
        type="button"
        disabled
        data-token-advance
        aria-describedby={descriptionId}
      >
        {String(data.interaction ?? "Avancer d'un token")}
      </button>
      {typeof data.warning === 'string' && (
        <p class="token-predictor__warning"><span aria-hidden="true">≠</span>{data.warning}</p>
      )}
    </div>

    {candidates.length > 0 && (
      <div class="token-predictor__candidates">
        <p class="scene-label">Suites possibles</p>
        <ol>
          {candidates.map((candidate, index) => (
            <li data-rank={index + 1}>
              <strong>{candidate.token}</strong>
              <span>{candidate.plausibility}</span>
            </li>
          ))}
        </ol>
        {typeof data.legend === 'string' && <p class="token-predictor__legend">{data.legend}</p>}
      </div>
    )}

    {loop.length > 0 && (
      <ol class="token-predictor__loop" aria-label="Boucle de génération">
        {loop.map((step, index) => (
          <li class:list={{ 'is-active': step === data.activeStep }}>
            <span>{String(index + 1).padStart(2, '0')}</span>{step}
          </li>
        ))}
      </ol>
    )}

  </div>
</SceneFrame>

<script>
  import { advanceTokenState, tokenEnhancementState } from './visual-state';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-token-predictor]').forEach((scene) => {
    const tokenElements = Array.from(scene.querySelectorAll<HTMLElement>('[data-token]'));
    const tokens = JSON.parse(scene.dataset.tokens ?? '[]') as string[];
    const button = scene.querySelector<HTMLButtonElement>('[data-token-advance]');
    const status = scene.querySelector<HTMLOutputElement>('[data-token-status]');
    if (!button || !status || tokens.length === 0) return;
    const enhancement = tokenEnhancementState(reducedMotion);
    if (!enhancement.interactive) {
      button.disabled = true;
      button.hidden = enhancement.controlHidden;
      status.textContent = `État final · phrase complète · ${tokens.length} fragments`;
      scene.dataset.complete = 'true';
      return;
    }

    button.disabled = false;

    let index = 0;
    const render = () => {
      tokenElements.forEach((token, tokenIndex) => { token.hidden = tokenIndex > index; });
      const complete = index === tokens.length - 1;
      status.textContent = complete
        ? `Phrase complète · ${tokens.length} fragments`
        : `Fragment ${index + 1} sur ${tokens.length}`;
      button.textContent = complete ? 'Rejouer la construction' : "Avancer d'un token";
      scene.dataset.complete = String(complete);
    };

    render();
    button.addEventListener('click', () => {
      if (index === tokens.length - 1) index = 0;
      else index = advanceTokenState(index, tokens).index;
      render();
    });
  });
</script>

<style>
  .token-predictor__scene {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(14rem, 0.75fr);
    gap: clamp(0.8rem, 2vw, 2rem);
    align-items: center;
    min-block-size: 100%;
  }

  .token-predictor__assembly {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.65rem;
    align-content: center;
    min-inline-size: 0;
  }

  .token-predictor__assembly > .scene-label,
  .token-predictor__sentence {
    grid-column: 1 / -1;
  }

  .token-predictor__status { align-self: center; }

  .token-predictor__sentence {
    min-block-size: 1.15em;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.7rem + 2vw, 4rem);
    font-weight: 760;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .token-predictor__sentence [data-token] {
    display: inline;
    padding-block: 0.04em;
    background: linear-gradient(transparent 67%, var(--family-accent) 67% 91%, transparent 91%);
  }

  .token-predictor__sentence [data-token][hidden] {
    display: none;
  }

  .token-predictor__sentence [data-token] + [data-token] {
    background: none;
  }

  .token-predictor__cursor {
    display: inline-block;
    inline-size: 0.08em;
    block-size: 0.82em;
    margin-inline-start: 0.08em;
    background: var(--presentation-ink);
    vertical-align: -0.02em;
  }

  .token-predictor__status,
  .token-predictor__legend {
    color: var(--presentation-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.68rem + 0.15vw, 0.86rem);
  }

  .token-predictor__advance {
    justify-self: start;
    min-block-size: 3rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--presentation-ink);
    border-radius: 999px;
    background: var(--presentation-ink);
    color: var(--presentation-surface);
    font-weight: 760;
  }

  .token-predictor__candidates ol,
  .token-predictor__loop {
    display: grid;
    gap: 0;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .token-predictor__candidates li {
    display: grid;
    grid-template-columns: minmax(4rem, 0.35fr) 1fr;
    gap: 0.75rem;
    padding-block: 0.32rem;
    border-block-start: 1px solid color-mix(in srgb, var(--presentation-ink), transparent 78%);
  }

  .token-predictor__candidates li::before {
    content: attr(data-rank);
    grid-row: 1 / 3;
    color: var(--presentation-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .token-predictor__candidates strong { font-size: clamp(1rem, 0.9rem + 0.3vw, 1.2rem); }
  .token-predictor__candidates span { color: var(--presentation-muted); font-size: 0.72rem; }
  .token-predictor__legend { margin-block: 0.5rem 0; }

  .token-predictor__loop {
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .token-predictor__loop li {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.4rem 0.7rem 0.35rem;
    border-block-start: 0.22rem solid var(--presentation-line);
    font-size: clamp(0.78rem, 0.7rem + 0.2vw, 0.92rem);
    font-weight: 650;
  }

  .token-predictor__loop li::after {
    position: absolute;
    inset-block-start: -0.43rem;
    inset-inline-end: -0.2rem;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-block-start: 0.2rem solid var(--presentation-line);
    border-inline-end: 0.2rem solid var(--presentation-line);
    content: '';
    rotate: 45deg;
  }

  .token-predictor__loop li.is-active {
    border-color: var(--family-accent);
    background: color-mix(in srgb, var(--family-accent), transparent 84%);
  }

  .token-predictor__loop span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.7rem; }

  .token-predictor__warning {
    display: flex;
    grid-column: 1 / -1;
    gap: 0.7rem;
    align-items: center;
    margin: 0;
    font-size: 0.82rem;
    font-weight: 730;
  }

  .token-predictor__warning span {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--family-accent);
  }

  @media (max-width: 52rem) {
    .token-predictor__scene { grid-template-columns: 1fr; }
    .token-predictor__assembly { grid-template-columns: 1fr; }
    .token-predictor__advance { grid-column: 1; }
    .token-predictor__loop { grid-template-columns: 1fr 1fr; }
    .token-predictor__loop li::after { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .token-predictor__cursor { display: none; }
  }
</style>
