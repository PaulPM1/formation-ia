---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';

interface Level {
  need: string;
  output: string;
  workflow: string;
  solutions: string[];
}

interface Solution {
  name: string;
  ecosystem: string;
  context: string;
  workflow: string[];
  output: string;
  actions: string;
  limit: string;
  proof: string;
  access: string;
}

interface Question {
  criterion: string;
  question: string;
}

interface Props { slide: RoutedSlide }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = String(data.variant ?? 'landscape');
const levels = Array.isArray(data.levels) ? data.levels as Level[] : [];
const solutions = Array.isArray(data.solutions) ? data.solutions as Solution[] : [];
const questions = Array.isArray(data.questions) ? data.questions as Question[] : [];
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class={`solution-comparison solution-comparison--${variant}`}
>
  {variant === 'landscape' && (
    <div class="comparison__landscape">
      <ol class="comparison__levels">
        {levels.map((level, index) => (
          <li>
            <span class="comparison__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="comparison__need">
              <small>Sortie attendue</small>
              <strong>{level.need}</strong>
              <span>{level.output}</span>
            </div>
            <p class="comparison__workflow">{level.workflow}</p>
            <div class="comparison__ecosystems" aria-label={`Solutions pour ${level.need}`}>
              {level.solutions.map((solution) => {
                const ecosystem = solution.startsWith('Claude') ? 'Claude' : 'OpenAI';
                return <span data-ecosystem={ecosystem}><small>{ecosystem}</small>{solution}</span>;
              })}
            </div>
          </li>
        ))}
      </ol>
      {typeof data.warning === 'string' && <p class="comparison__warning"><strong>Accès</strong>{data.warning}</p>}
    </div>
  )}

  {variant === 'pair' && (
    <div class="comparison__pair" data-solution-comparison>
      <div class="comparison__pair-head">
        <p><span>Besoin</span>{String(data.need ?? '')}</p>
        <fieldset>
          <legend>{String(data.interaction ?? 'Comparer les deux solutions')}</legend>
          {solutions.map((solution, index) => (
            <label>
              <input
                type="radio"
                name={`${slide.id}-solution`}
                value={String(index)}
                checked={index === 0}
                disabled
                data-solution-choice
              />
              <span>{solution.name}</span>
            </label>
          ))}
        </fieldset>
      </div>

      <div class="comparison__panels" aria-live="polite">
        {solutions.map((solution, index) => (
          <article data-solution-panel={index} data-ecosystem={solution.ecosystem}>
            <header>
              <span>{solution.ecosystem}</span>
              <h2>{solution.name}</h2>
              <p>{solution.output}</p>
            </header>

            <ol class="comparison__flow" aria-label="Workflow">
              {solution.workflow.map((step) => <li>{step}</li>)}
            </ol>

            <dl>
              <div><dt>Contexte</dt><dd>{solution.context}</dd></div>
              <div><dt>Actions</dt><dd>{solution.actions}</dd></div>
              <div class="comparison__limit"><dt>Limite</dt><dd>{solution.limit}</dd></div>
              <div class="comparison__proof"><dt>Preuve</dt><dd>{solution.proof}</dd></div>
              <div><dt>Accès requis</dt><dd>{solution.access}</dd></div>
            </dl>
          </article>
        ))}
      </div>

      {typeof data.choiceSignal === 'string' && (
        <p class="comparison__signal"><strong>Signal de choix</strong>{data.choiceSignal}</p>
      )}
    </div>
  )}

  {variant === 'decision' && (
    <div class="comparison__decision">
      <ol>
        {questions.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><strong>{item.criterion}</strong><p>{item.question}</p></div>
          </li>
        ))}
      </ol>
      <aside>
        <p><strong>Départage</strong>{String(data.tieBreaker ?? '')}</p>
        <p><strong>Piège</strong>{String(data.warning ?? '')}</p>
      </aside>
    </div>
  )}
</SceneFrame>

<script>
  import { onPresenterPage } from '../../../../scripts/on-presenter-page';

  onPresenterPage(() => {
    document.querySelectorAll<HTMLElement>('[data-solution-comparison]').forEach((comparison) => {
      const choices = Array.from(comparison.querySelectorAll<HTMLInputElement>('[data-solution-choice]'));
      const panels = Array.from(comparison.querySelectorAll<HTMLElement>('[data-solution-panel]'));
      comparison.dataset.enhanced = 'true';

      const show = (value: string) => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.solutionPanel !== value; });
      };

      choices.forEach((choice) => {
        choice.disabled = false;
        choice.addEventListener('change', () => show(choice.value));
      });
      show(choices.find((choice) => choice.checked)?.value ?? '0');
    });
  });
</script>

<style>
  .comparison__landscape,
  .comparison__pair,
  .comparison__decision { min-block-size: 100%; }

  .comparison__landscape { display: grid; grid-template-rows: 1fr auto; gap: .65rem; }
  .comparison__levels { display: grid; gap: .45rem; margin: 0; padding: 0; list-style: none; }
  .comparison__levels li {
    display: grid;
    grid-template-columns: 2.5rem minmax(10rem, .75fr) minmax(14rem, 1.1fr) minmax(17rem, 1fr);
    gap: .75rem;
    align-items: center;
    padding: .55rem .7rem;
    border: 1px solid var(--presentation-line);
    border-inline-start: .34rem solid var(--family-accent);
    background: color-mix(in srgb, var(--presentation-surface), transparent 8%);
  }
  .comparison__index { font-family: var(--font-mono); font-size: .82rem; color: var(--presentation-muted); }
  .comparison__need { display: grid; gap: .1rem; }
  .comparison__need small,
  .comparison__ecosystems small { font-family: var(--font-mono); font-size: .75rem; color: var(--presentation-muted); text-transform: uppercase; }
  .comparison__need strong { font-family: var(--font-display); font-size: clamp(1.05rem, 1rem + .35vw, 1.35rem); }
  .comparison__need span,
  .comparison__workflow { margin: 0; font-size: .82rem; line-height: 1.25; }
  .comparison__workflow { padding-inline: .55rem; border-inline: 1px solid var(--presentation-line); }
  .comparison__ecosystems { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
  .comparison__ecosystems > span { display: grid; gap: .1rem; min-inline-size: 0; padding: .4rem .5rem; border: 1px solid var(--presentation-line); font-weight: 760; }
  .comparison__ecosystems > span[data-ecosystem='Claude'] { border-block-end: .22rem solid var(--family-accent); }
  .comparison__ecosystems > span[data-ecosystem='OpenAI'] { border-block-end: .22rem solid var(--presentation-ink); }
  .comparison__warning,
  .comparison__signal { display: flex; gap: .65rem; align-items: baseline; margin: 0; padding: .45rem .65rem; border: 1px solid var(--presentation-line); font-size: .82rem; }
  .comparison__warning strong,
  .comparison__signal strong { flex: 0 0 auto; font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; }

  .comparison__pair { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: .55rem; }
  .comparison__pair-head { display: flex; gap: 1rem; justify-content: space-between; align-items: end; }
  .comparison__pair-head > p { display: grid; gap: .1rem; margin: 0; font-family: var(--font-display); font-size: 1.1rem; font-weight: 750; }
  .comparison__pair-head > p span { font-family: var(--font-mono); font-size: .75rem; color: var(--presentation-muted); text-transform: uppercase; }
  .comparison__pair fieldset { display: flex; gap: .35rem; margin: 0; padding: 0; border: 0; }
  .comparison__pair legend { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .comparison__pair label { display: flex; gap: .45rem; align-items: center; min-block-size: 2.7rem; padding: .4rem .65rem; border: 1px solid var(--presentation-line); cursor: pointer; font-weight: 750; }
  .comparison__pair label:has(input:checked) { border-color: var(--presentation-ink); border-block-end: .22rem solid var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 88%); }
  .comparison__pair input { inline-size: 1.05rem; block-size: 1.05rem; accent-color: var(--presentation-ink); }
  .comparison__pair input:focus-visible { outline: .2rem solid var(--presentation-focus); outline-offset: .18rem; }
  .comparison__panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; min-block-size: 0; }
  .comparison__pair[data-enhanced='true'] .comparison__panels { grid-template-columns: 1fr; }
  .comparison__panels article { display: grid; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1.35fr); grid-template-rows: auto 1fr; gap: .45rem .75rem; min-block-size: 0; padding: .65rem; border: 1px solid var(--presentation-line); }
  .comparison__panels article[hidden] { display: none; }
  .comparison__panels header { display: grid; align-content: start; gap: .15rem; padding-inline-end: .65rem; border-inline-end: .3rem solid var(--family-accent); }
  .comparison__panels header span { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; color: var(--presentation-muted); }
  .comparison__panels h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.25rem, 1rem + .8vw, 1.8rem); }
  .comparison__panels header p { margin: 0; font-size: .85rem; line-height: 1.3; }
  .comparison__flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .3rem; align-items: center; margin: 0; padding: 0; list-style: none; }
  .comparison__flow li { position: relative; padding: .42rem .3rem; border-block: 1px solid var(--presentation-line); font-size: .78rem; text-align: center; }
  .comparison__flow li:not(:last-child)::after { content: '→'; position: absolute; inset-inline-end: -.33rem; font-weight: 800; }
  .comparison__panels dl { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .4rem; margin: 0; }
  .comparison__panels dl > div { min-inline-size: 0; padding: .4rem; border-block-start: 1px solid var(--presentation-line); }
  .comparison__panels dt { font-family: var(--font-mono); font-size: .75rem; font-weight: 750; text-transform: uppercase; color: var(--presentation-muted); }
  .comparison__panels dd { margin: .18rem 0 0; font-size: .78rem; line-height: 1.28; }
  .comparison__limit { background: color-mix(in srgb, #f2b84b, transparent 88%); }
  .comparison__proof { background: color-mix(in srgb, var(--family-accent), transparent 88%); }

  .comparison__decision { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(15rem, .65fr); gap: .8rem; align-items: stretch; }
  .comparison__decision ol { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .comparison__decision li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: .65rem; align-items: center; padding: .55rem .7rem; border: 1px solid var(--presentation-line); }
  .comparison__decision li > span { font-family: var(--font-mono); font-size: 1rem; font-weight: 800; color: var(--family-accent); }
  .comparison__decision li div { display: grid; grid-template-columns: 7rem 1fr; gap: .5rem; align-items: baseline; }
  .comparison__decision li strong { font-family: var(--font-display); font-size: 1.05rem; }
  .comparison__decision li p,
  .comparison__decision aside p { margin: 0; font-size: .85rem; line-height: 1.3; }
  .comparison__decision aside { display: grid; gap: .5rem; align-content: end; }
  .comparison__decision aside p { display: grid; gap: .3rem; padding: .7rem; border: 1px solid var(--presentation-line); }
  .comparison__decision aside strong { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; }

  @media (max-width: 760px) {
    .comparison__levels li { grid-template-columns: 2rem 1fr; }
    .comparison__workflow,
    .comparison__ecosystems { grid-column: 2; }
    .comparison__pair-head { align-items: stretch; flex-direction: column; }
    .comparison__pair fieldset { display: grid; grid-template-columns: 1fr 1fr; }
    .comparison__pair label { justify-content: center; }
    .comparison__panels,
    .comparison__pair[data-enhanced='true'] .comparison__panels { grid-template-columns: 1fr; }
    .comparison__panels article { grid-template-columns: 1fr; }
    .comparison__panels header { border-inline-end: 0; border-block-end: .3rem solid var(--family-accent); padding-block-end: .4rem; }
    .comparison__flow,
    .comparison__panels dl { grid-column: 1; grid-template-columns: 1fr; }
    .comparison__flow li:not(:last-child)::after { content: '↓'; inset-inline-end: .25rem; }
    .comparison__decision { grid-template-columns: 1fr; }
    .comparison__decision li div { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .comparison__pair * { scroll-behavior: auto; transition-duration: .001ms !important; }
  }
</style>
