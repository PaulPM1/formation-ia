---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { calculateContextSelection, getContextBudgetVariant } from './visual-state';

interface MeterItem {
  item: string;
  contextLoad: string;
  relevance: string;
  keep: boolean;
}

interface Props { slide: RoutedSlide; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getContextBudgetVariant(data);
const layers = Array.isArray(data.layers)
  ? data.layers as Array<{ name: string; measures: string; check: string }>
  : [];
const meter = Array.isArray(data.meter) ? data.meter as MeterItem[] : [];
const comparisons = Array.isArray(data.comparisons)
  ? data.comparisons as Array<{ mode: string; context: string; toolUse: string; progression: string }>
  : [];
const fields = Array.isArray(data.fields) ? data.fields.map(String) : [];
const initialSelection = calculateContextSelection(meter.length, meter.map((item) => item.keep));
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="context-budget">
  <div class="budget__scene" data-context-budget data-variant={variant}>
    {variant === 'layers' && (
      <section class="budget__layers" aria-label="Les trois réalités du coût">
        <fieldset class="budget__tabs">
          <legend>{String(data.interaction ?? 'Explorer les trois couches')}</legend>
          {layers.map((layer, index) => (
            <label>
              <input type="radio" name={`${slide.id}-layer`} value={index} checked={index === 0} disabled data-panel-choice />
              <span>{String(index + 1).padStart(2, '0')}</span><strong>{layer.name}</strong>
            </label>
          ))}
        </fieldset>
        <div class="budget__layer-panels">
          {layers.map((layer) => (
            <article data-panel>
              <h3>{layer.name}</h3>
              <dl><div><dt>Mesure</dt><dd>{layer.measures}</dd></div><div><dt>À vérifier</dt><dd>{layer.check}</dd></div></dl>
            </article>
          ))}
        </div>
        {typeof data.warning === 'string' && <p class="budget__warning"><span aria-hidden="true">!</span>{data.warning}</p>}
      </section>
    )}

    {variant === 'meter' && (
      <div class="budget__meter-layout">
        <fieldset class="budget__items">
          <legend>{String(data.interaction ?? 'Ajouter ou retirer du contexte')}</legend>
          <ul>
            {meter.map((item, index) => (
              <li>
                <input id={`${slide.id}-meter-${index}`} type="checkbox" checked={item.keep} disabled data-meter-choice />
                <label for={`${slide.id}-meter-${index}`}><strong>{item.item}</strong><span>Charge {item.contextLoad} · pertinence {item.relevance}</span></label>
              </li>
            ))}
          </ul>
        </fieldset>
        <section class="budget__count" aria-labelledby={`${slide.id}-count-title`}>
          <p class="scene-label" id={`${slide.id}-count-title`}>Éléments retenus</p>
          <meter min="0" max={initialSelection.total || 1} value={initialSelection.included} data-context-meter>{initialSelection.included} sur {initialSelection.total}</meter>
          <output data-context-output aria-live="polite"><strong>{initialSelection.included}</strong><span>sur {initialSelection.total} éléments inclus</span></output>
          {typeof data.objective === 'string' && <p class="budget__principle"><span aria-hidden="true">✓</span>{data.objective}</p>}
        </section>
      </div>
    )}

    {variant === 'comparison' && (
      <section class="budget__comparison" aria-label="Deux parcours de consommation qualitatifs">
        <p class="scene-label">{String(data.interaction ?? 'Comparer les parcours')}</p>
        <div class="budget__paths">
          {comparisons.map((comparison, index) => (
            <article>
              <header><span>{String(index + 1).padStart(2, '0')}</span><h3>{comparison.mode}</h3></header>
              <ol>
                <li><small>Contexte</small><strong>{comparison.context}</strong></li>
                <li><small>Outils</small><strong>{comparison.toolUse}</strong></li>
                <li><small>Progression</small><strong>{comparison.progression}</strong></li>
              </ol>
            </article>
          ))}
        </div>
        {typeof data.relationship === 'string' && <p class="budget__relationship">{data.relationship}</p>}
        {Array.isArray(data.factors) && <p class="budget__factors"><span>Facteurs</span>{data.factors.map(String).join(' · ')}</p>}
      </section>
    )}

    {variant === 'mission' && (
      <section class="budget__mission">
        <header><p class="scene-label">Fiche budget</p><h3>{String(data.mission ?? 'Construire une fiche budget')}</h3></header>
        <fieldset>
          <legend>{String(data.interaction ?? 'Décider les bornes de la mission')}</legend>
          <ol>{fields.map((field, index) => <li><input id={`${slide.id}-field-${index}`} type="checkbox" data-mission-choice /><label for={`${slide.id}-field-${index}`}><span>{String(index + 1).padStart(2, '0')}</span>{field}</label></li>)}</ol>
        </fieldset>
        <p class="budget__criterion"><span aria-hidden="true">✓</span>{String(data.successCriterion ?? '')}</p>
      </section>
    )}
  </div>
</SceneFrame>

<script>
  import { calculateContextSelection, resolvePanelVisibility } from './visual-state';

  document.querySelectorAll<HTMLElement>('[data-context-budget]').forEach((scene) => {
    const panelChoices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-panel-choice]'));
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-panel]'));
    if (panelChoices.length && panels.length) {
      scene.dataset.enhanced = 'true';
      const renderPanel = (active: number) => {
        resolvePanelVisibility(panels.length, active, true).forEach((visible, index) => { panels[index].hidden = !visible; });
      };
      panelChoices.forEach((choice, index) => {
        choice.disabled = false;
        choice.addEventListener('change', () => renderPanel(index));
      });
      renderPanel(Math.max(0, panelChoices.findIndex((choice) => choice.checked)));
    }

    const meterChoices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-meter-choice]'));
    const meter = scene.querySelector<HTMLMeterElement>('[data-context-meter]');
    const output = scene.querySelector<HTMLOutputElement>('[data-context-output]');
    if (meterChoices.length && meter && output) {
      meterChoices.forEach((choice) => { choice.disabled = false; });
      const renderMeter = () => {
        const selection = calculateContextSelection(meterChoices.length, meterChoices.map((choice) => choice.checked));
        meter.max = Math.max(1, selection.total);
        meter.value = selection.included;
        const strong = output.querySelector('strong');
        const span = output.querySelector('span');
        if (strong) strong.textContent = String(selection.included);
        if (span) span.textContent = `sur ${selection.total} éléments inclus`;
      };
      meterChoices.forEach((choice) => choice.addEventListener('change', renderMeter));
    }
  });
</script>

<style>
  .budget__scene { min-block-size: 100%; }
  .budget__layers, .budget__comparison, .budget__mission { display: grid; gap: clamp(0.5rem, 1.2vw, 0.9rem); align-content: center; min-block-size: 100%; }
  .budget__tabs { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; border: 0; }
  .budget__tabs legend, .budget__items legend, .budget__mission legend { margin-block-end: 0.45rem; font-family: var(--font-display); font-size: 1rem; font-weight: 720; }
  .budget__tabs label { display: grid; grid-template-columns: auto 1fr; gap: 0.05rem 0.45rem; padding: 0.35rem 0.55rem; border-block-start: 0.22rem solid var(--presentation-line); }
  .budget__tabs label:has(input:checked) { border-color: var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 84%); }
  .budget__tabs input { grid-row: 1 / 3; align-self: center; inline-size: 1rem; block-size: 1rem; accent-color: var(--presentation-ink); }
  .budget__tabs span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.7rem; }
  .budget__tabs strong { font-size: 0.82rem; }
  .budget__layer-panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  [data-enhanced='true'] .budget__layer-panels { grid-template-columns: 1fr; }
  .budget__layer-panels article { display: grid; grid-template-columns: minmax(7rem, .4fr) 1fr; gap: 0.8rem; padding: 0.7rem; border: 1px solid var(--presentation-line); background: var(--presentation-surface); }
  .budget__layer-panels h3, .budget__paths h3, .budget__mission h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1rem, .85rem + .5vw, 1.35rem); }
  .budget__layer-panels dl { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 0; }
  .budget__layer-panels dl div { display: grid; gap: 0.1rem; }
  .budget__layer-panels dt, .budget__paths small { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; }
  .budget__layer-panels dd { margin: 0; font-size: 0.78rem; line-height: 1.2; }
  .budget__warning, .budget__relationship, .budget__factors, .budget__criterion { margin: 0; padding-inline-start: 0.7rem; border-inline-start: 0.28rem solid var(--family-accent); font-size: 0.78rem; font-weight: 680; }

  .budget__meter-layout { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; min-block-size: 100%; }
  .budget__items { margin: 0; padding: 0; border: 0; }
  .budget__items ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .budget__items li { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: center; min-block-size: 2.4rem; padding-block: 0.2rem; border-block-start: 1px solid var(--presentation-line); }
  .budget__items input { inline-size: 1.15rem; block-size: 1.15rem; accent-color: var(--presentation-ink); }
  .budget__items label { display: grid; cursor: pointer; }
  .budget__items strong { font-size: 0.82rem; }
  .budget__items label span { color: var(--presentation-muted); font-size: 0.7rem; line-height: 1.15; }
  .budget__items li:has(input:not(:checked)) label { opacity: .5; }
  .budget__count { display: grid; gap: .4rem; padding-inline-start: 1.2rem; border-inline-start: .35rem solid var(--family-accent); }
  .budget__count meter { inline-size: 100%; block-size: 1.4rem; accent-color: var(--family-accent); }
  .budget__count output { display: flex; gap: .5rem; align-items: baseline; }
  .budget__count output strong { font-family: var(--font-display); font-size: 2.6rem; line-height: .9; }
  .budget__count output span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: .7rem; }
  .budget__principle { display: flex; gap: .45rem; margin: .25rem 0 0; font-size: .78rem; font-weight: 680; }

  .budget__paths { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .budget__paths article { padding: .65rem .8rem; border-block-start: .3rem solid var(--family-accent); background: var(--presentation-surface); }
  .budget__paths header { display: flex; gap: .6rem; align-items: baseline; }
  .budget__paths header span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: .7rem; }
  .budget__paths ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; margin: .55rem 0 0; padding: 0; list-style: none; }
  .budget__paths li { display: grid; gap: .15rem; position: relative; }
  .budget__paths li:not(:last-child)::after { position: absolute; inset-inline-end: -.35rem; content: '→'; color: var(--family-accent); }
  .budget__paths strong { font-size: .7rem; line-height: 1.15; }
  .budget__factors span { margin-inline-end: .7rem; color: var(--presentation-muted); font-family: var(--font-mono); }

  .budget__mission { grid-template-columns: minmax(13rem, .55fr) 1fr; column-gap: 1.4rem; }
  .budget__mission header { align-self: center; }
  .budget__mission fieldset { margin: 0; padding: 0; border: 0; }
  .budget__mission ol { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem .8rem; margin: 0; padding: 0; list-style: none; }
  .budget__mission li { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .45rem; padding: .35rem; border-block-start: 1px solid var(--presentation-line); }
  .budget__mission input { inline-size: 1.1rem; block-size: 1.1rem; accent-color: var(--presentation-ink); }
  .budget__mission label { display: grid; grid-template-columns: 1.4rem 1fr; gap: .35rem; font-size: .72rem; font-weight: 680; line-height: 1.15; }
  .budget__mission label span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: .7rem; }
  .budget__criterion { grid-column: 1 / -1; }

  [data-panel][hidden] { display: none !important; }
  @media (max-width: 52rem) {
    .budget__meter-layout, .budget__mission { grid-template-columns: 1fr; }
    .budget__layer-panels, .budget__paths { grid-template-columns: 1fr; }
    .budget__count { padding-block-start: .8rem; padding-inline-start: 0; border-block-start: .3rem solid var(--family-accent); border-inline-start: 0; }
  }
</style>
