---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { calculateContextBudget } from './visual-state';

interface MeterItem {
  item: string;
  contextLoad: string;
  relevance: string;
  keep: boolean;
}

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
let items: MeterItem[] = [];

if (Array.isArray(data.meter)) {
  items = data.meter as MeterItem[];
} else if (Array.isArray(data.layers)) {
  items = (data.layers as Array<{ name: string; measures: string; check: string }>).map((layer) => ({
    item: layer.name,
    contextLoad: 'faible',
    relevance: `${layer.measures} · Vérifier : ${layer.check}`,
    keep: true,
  }));
} else if (Array.isArray(data.comparisons)) {
  items = (data.comparisons as Array<{ mode: string; context: string; toolUse: string; progression: string }>).map((comparison, index) => ({
    item: comparison.mode,
    contextLoad: index === 0 ? 'faible' : 'élevée',
    relevance: `${comparison.context} · ${comparison.toolUse} · ${comparison.progression}`,
    keep: true,
  }));
} else if (Array.isArray(data.fields)) {
  items = data.fields.map((field) => ({
    item: String(field),
    contextLoad: 'faible',
    relevance: 'sert à borner ou vérifier le résultat',
    keep: true,
  }));
}

const budgetItems = items.map((item) => ({
  load: item.contextLoad,
  useful: !['faible', 'nulle'].includes(item.relevance),
}));
const included = items.map((item) => item.keep);
const initialBudget = calculateContextBudget(budgetItems, included);
const utility = String(
  data.objective
  ?? data.successCriterion
  ?? data.relationship
  ?? data.warning
  ?? 'Conserver uniquement le contexte qui sert le résultat ou sa vérification.',
);
const utilityId = `${slide.id}-budget-utility`;
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class="context-budget"
>
  <div
    class="budget__scene"
    data-context-budget
    data-budget-items={JSON.stringify(budgetItems)}
  >
    <fieldset class:list={['budget__items', { 'budget__items--dense': items.length >= 5 }]} aria-describedby={utilityId}>
      <legend>{String(data.interaction ?? 'Composer le budget de contexte')}</legend>
      <ul>
        {items.map((item, index) => (
          <li>
            <input
              id={`${slide.id}-budget-${index}`}
              type="checkbox"
              checked={item.keep}
              data-budget-choice={index}
            />
            <label for={`${slide.id}-budget-${index}`}>
              <strong>{item.item}</strong>
              <span>{item.contextLoad} · {item.relevance}</span>
            </label>
          </li>
        ))}
      </ul>
    </fieldset>

    <section class="budget__meter" aria-labelledby={`${slide.id}-meter-title`}>
      <p class="scene-label" id={`${slide.id}-meter-title`}>Contexte mobilisé</p>
      <div class="budget__dial">
        <meter
          min="0"
          max={initialBudget.capacity || 1}
          value={initialBudget.load}
          data-budget-meter
        >
          {initialBudget.percentage}%
        </meter>
        <output data-budget-output aria-live="polite">
          <strong>{initialBudget.percentage}%</strong>
          <span>{included.filter(Boolean).length} éléments inclus</span>
        </output>
      </div>
      <p id={utilityId} class="budget__utility">
        <span aria-hidden="true">✓</span>{utility}
      </p>
      {typeof data.warning === 'string' && utility !== data.warning && <p class="budget__warning">{data.warning}</p>}
    </section>
  </div>
</SceneFrame>

<script>
  import { calculateContextBudget } from './visual-state';

  document.querySelectorAll<HTMLElement>('[data-context-budget]').forEach((scene) => {
    const items = JSON.parse(scene.dataset.budgetItems ?? '[]') as Array<{ load: string; useful: boolean }>;
    const choices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-budget-choice]'));
    const meter = scene.querySelector<HTMLMeterElement>('[data-budget-meter]');
    const output = scene.querySelector<HTMLOutputElement>('[data-budget-output]');
    const percentage = output?.querySelector<HTMLElement>('strong');
    const summary = output?.querySelector<HTMLElement>('span');
    if (!meter || !percentage || !summary) return;

    const render = () => {
      const included = choices.map((choice) => choice.checked);
      const budget = calculateContextBudget(items, included);
      meter.max = Math.max(1, budget.capacity);
      meter.value = budget.load;
      percentage.textContent = `${budget.percentage}%`;
      summary.textContent = `${included.filter(Boolean).length} éléments inclus · ${budget.useful} utiles`;
    };

    choices.forEach((choice) => choice.addEventListener('change', render));
  });
</script>

<style>
  .budget__scene {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    min-block-size: 100%;
  }

  .budget__items {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .budget__items legend {
    margin-block-end: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.4vw, 1.25rem);
    font-weight: 720;
  }

  .budget__items ul { display: grid; margin: 0; padding: 0; list-style: none; }

  .budget__items--dense ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1rem;
  }

  .budget__items li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    min-block-size: 2.3rem;
    padding-block: 0.24rem;
    border-block-start: 1px solid var(--presentation-line);
  }

  .budget__items input { inline-size: 1.25rem; block-size: 1.25rem; margin: 0; accent-color: var(--presentation-ink); }
  .budget__items label { display: grid; cursor: pointer; }
  .budget__items strong { font-size: clamp(0.82rem, 0.74rem + 0.22vw, 0.95rem); }
  .budget__items label span { overflow: hidden; color: var(--presentation-muted); font-size: 0.7rem; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .budget__items li:has(input:not(:checked)) label { opacity: 0.48; text-decoration: line-through; }

  .budget__meter {
    display: grid;
    gap: 0.4rem;
    padding-inline-start: clamp(1rem, 2vw, 1.8rem);
    border-inline-start: 0.35rem solid var(--family-accent);
  }

  .budget__dial { display: grid; gap: 0.35rem; }
  .budget__dial meter { inline-size: 100%; block-size: 1.5rem; accent-color: var(--family-accent); }
  .budget__dial meter::-webkit-meter-bar { border: 1px solid var(--presentation-ink); border-radius: 0; background: var(--presentation-surface); }
  .budget__dial meter::-webkit-meter-optimum-value { background: var(--family-accent); }
  .budget__dial output { display: grid; }
  .budget__dial output strong { font-family: var(--font-display); font-size: clamp(2.2rem, 1.75rem + 1.2vw, 3rem); letter-spacing: -0.05em; line-height: 0.9; }
  .budget__dial output span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.72rem; }

  .budget__utility,
  .budget__warning { margin: 0; font-size: clamp(0.75rem, 0.7rem + 0.16vw, 0.86rem); font-weight: 680; }
  .budget__utility { display: flex; gap: 0.55rem; }
  .budget__utility span { display: grid; flex: 0 0 1.7rem; place-items: center; inline-size: 1.7rem; aspect-ratio: 1; border-radius: 50%; background: var(--family-accent); }
  .budget__warning { color: var(--presentation-muted); }

  @media (max-width: 52rem) {
    .budget__scene { grid-template-columns: 1fr; }
    .budget__meter { padding-block-start: 1rem; padding-inline-start: 0; border-block-start: 0.35rem solid var(--family-accent); border-inline-start: 0; }
    .budget__items label span { white-space: normal; }
    .budget__items--dense ul { grid-template-columns: 1fr; }
  }
</style>
