---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';
import { getVerificationVariant } from './visual-state';

interface Props { slide: RoutedSlide; }
interface RiskLevel { risk: string; example: string; verification: string; }

const { slide } = Astro.props;
const data = slide.visual.data;
const variant = getVerificationVariant(data);
const buckets = Array.isArray(data.buckets) ? data.buckets.map(String) : [];
const statements = Array.isArray(data.statements)
  ? data.statements as Array<{ text: string; category: string; fictional?: boolean }>
  : [];
const biases = Array.isArray(data.biases) ? data.biases as Array<{ name: string; effect: string }> : [];
const scale = Array.isArray(data.scale) ? data.scale as RiskLevel[] : [];
const steps = Array.isArray(data.steps) ? data.steps as Array<{ name: string; action: string }> : [];
const resultId = `${slide.id}-audit-result`;
---

<SceneFrame title={slide.claim} description={slide.accessibleDescription} visualKey={slide.visual.key} class="verification-audit">
  <div class="audit__scene" data-verification-audit data-variant={variant} data-answer={String(data.answer ?? '')} data-reason={String(data.reason ?? '')}>
    {variant === 'classification' && (
      <section class="audit__classification">
        <div class="audit__prompt">
          <p class="scene-label">Affirmation à classer</p>
          <blockquote>{String(data.statement ?? '')}</blockquote>
        </div>
        <fieldset aria-describedby={resultId}>
          <legend>{String(data.interaction ?? 'Choisir une catégorie')}</legend>
          <div class="audit__choices">
            {buckets.map((bucket, index) => (
              <label><input type="radio" name={`${slide.id}-classification`} value={bucket} data-classification-choice /><span>{String(index + 1).padStart(2, '0')}</span><strong>{bucket}</strong></label>
            ))}
          </div>
          <button type="button" disabled data-classification-reveal>Afficher la correction</button>
          <output id={resultId} hidden data-classification-result aria-live="polite"></output>
          <details data-static-correction><summary>Correction accessible sans interaction enrichie</summary><p><strong>{String(data.answer ?? '')}</strong> · {String(data.reason ?? '')}</p></details>
        </fieldset>
      </section>
    )}

    {variant === 'statements' && (
      <section class="audit__statements">
        <header><div><p class="scene-label">Réponse fluide à auditer</p><p>{String(data.initialSignal ?? '')}</p></div><button type="button" disabled data-reveal-next>Révéler la catégorie suivante</button></header>
        {typeof data.exerciseNotice === 'string' && <p class="audit__notice">{data.exerciseNotice}</p>}
        <ol>
          {statements.map((statement, index) => (
            <li><span class="audit__number">{String(index + 1).padStart(2, '0')}</span><strong>{statement.text}</strong><small data-statement-category>{statement.category}</small></li>
          ))}
        </ol>
        <p class="audit__reveal-status" data-reveal-status aria-live="polite">Les cinq catégories sont affichées.</p>
      </section>
    )}

    {variant === 'biases' && (
      <section class="audit__explorer">
        <fieldset class="audit__selector"><legend>{String(data.interaction ?? 'Explorer les biais')}</legend>{biases.map((bias, index) => <label><input type="radio" name={`${slide.id}-bias`} value={index} checked={index === 0} disabled data-audit-choice /><span>{String(index + 1).padStart(2, '0')}</span><strong>{bias.name}</strong></label>)}</fieldset>
        <div class="audit__panels">{biases.map((bias) => <article data-audit-panel><p class="scene-label">Raccourci mental</p><h3>{bias.name}</h3><p>{bias.effect}</p></article>)}</div>
      </section>
    )}

    {variant === 'risk' && (
      <section class="audit__risk">
        <header><p class="scene-label">Effort proportionné</p><h3>{String(data.question ?? '')}</h3></header>
        <fieldset class="audit__selector"><legend>{String(data.interaction ?? 'Choisir le niveau de risque')}</legend>{scale.map((level, index) => <label><input type="radio" name={`${slide.id}-risk`} value={index} checked={index === 0} disabled data-audit-choice /><span>{String(index + 1).padStart(2, '0')}</span><strong>{level.risk}</strong></label>)}</fieldset>
        <div class="audit__panels audit__panels--risk">{scale.map((level) => <article data-audit-panel><p class="scene-label">{level.risk}</p><h3>{level.example}</h3><p><strong>Vérifier</strong> · {level.verification}</p></article>)}</div>
      </section>
    )}

    {variant === 'method' && (
      <section class="audit__method">
        <fieldset class="audit__selector"><legend>{String(data.interaction ?? 'Parcourir la méthode')}</legend>{steps.map((step, index) => <label><input type="radio" name={`${slide.id}-step`} value={index} checked={index === 0} disabled data-audit-choice /><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.name}</strong></label>)}</fieldset>
        <div class="audit__panels">{steps.map((step, index) => <article data-audit-panel><p class="scene-label">Étape {String(index + 1).padStart(2, '0')}</p><h3>{step.name}</h3><p>{step.action}</p></article>)}</div>
        {typeof data.output === 'string' && <p class="audit__output"><span>Sortie</span>{data.output}</p>}
      </section>
    )}
  </div>
</SceneFrame>

<script>
  import { resolvePanelVisibility } from './visual-state';
  import { onPresenterPage } from '../../../../scripts/on-presenter-page';

  onPresenterPage(() => {
    document.querySelectorAll<HTMLElement>('[data-verification-audit]').forEach((scene) => {
      const variant = scene.dataset.variant;
      if (variant === 'classification') {
        const choices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-classification-choice]'));
        const reveal = scene.querySelector<HTMLButtonElement>('[data-classification-reveal]');
        const result = scene.querySelector<HTMLOutputElement>('[data-classification-result]');
        const staticCorrection = scene.querySelector<HTMLDetailsElement>('[data-static-correction]');
        if (!reveal || !result) return;
        scene.dataset.enhanced = 'true';
        if (staticCorrection) staticCorrection.hidden = true;
        choices.forEach((choice) => choice.addEventListener('change', () => {
          reveal.disabled = false;
          result.hidden = true;
        }));
        reveal.addEventListener('click', () => {
          const selected = choices.find((choice) => choice.checked)?.value;
          if (!selected) return;
          const correct = selected === scene.dataset.answer;
          result.textContent = correct
            ? `Correct · ${scene.dataset.answer}. ${scene.dataset.reason}`
            : `À revoir · la réponse attendue est « ${scene.dataset.answer} ». ${scene.dataset.reason}`;
          result.hidden = false;
        });
        return;
      }

      if (variant === 'statements') {
        const categories = Array.from(scene.querySelectorAll<HTMLElement>('[data-statement-category]'));
        const button = scene.querySelector<HTMLButtonElement>('[data-reveal-next]');
        const status = scene.querySelector<HTMLElement>('[data-reveal-status]');
        if (!button || !categories.length) return;
        scene.dataset.enhanced = 'true';
        let revealed = 0;
        categories.forEach((category) => { category.hidden = true; });
        button.disabled = false;
        const revealNext = () => {
          if (revealed >= categories.length) return;
          categories[revealed].hidden = false;
          revealed += 1;
          if (status) status.textContent = `${revealed} catégorie${revealed > 1 ? 's' : ''} sur ${categories.length} révélée${revealed > 1 ? 's' : ''}.`;
          if (revealed === categories.length) {
            button.disabled = true;
            button.textContent = 'Audit complet';
          }
        };
        button.addEventListener('click', revealNext);
        revealNext();
        return;
      }

      const choices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-audit-choice]'));
      const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-audit-panel]'));
      if (!choices.length || !panels.length) return;
      scene.dataset.enhanced = 'true';
      const render = (active: number) => resolvePanelVisibility(panels.length, active, true).forEach((visible, index) => { panels[index].hidden = !visible; });
      choices.forEach((choice, index) => { choice.disabled = false; choice.addEventListener('change', () => render(index)); });
      render(Math.max(0, choices.findIndex((choice) => choice.checked)));
    });
  });
</script>

<style>
  .audit__scene { min-block-size: 0; }
  .audit__classification, .audit__explorer, .audit__risk, .audit__method { display: grid; grid-template-columns: minmax(0, .9fr) minmax(18rem, 1.1fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; min-block-size: 0; }
  .audit__prompt { display: grid; gap: .35rem; }
  .audit__prompt blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(1.25rem, 1rem + .75vw, 1.75rem); font-weight: 720; line-height: 1.05; }
  .audit__classification fieldset, .audit__selector { display: grid; gap: .16rem; margin: 0; padding: 0; border: 0; }
  .audit__classification legend, .audit__selector legend { margin-block-end: .16rem; font-family: var(--font-display); font-size: .9rem; font-weight: 720; }
  .audit__choices { display: grid; grid-template-columns: repeat(3, 1fr); }
  .audit__choices label, .audit__selector label { display: grid; grid-template-columns: auto 1fr; gap: 0 .4rem; align-items: center; padding: .16rem .4rem; border-block-start: .18rem solid var(--presentation-line); }
  .audit__selector label { grid-template-columns: auto 1.35rem 1fr; }
  .audit__choices label:has(input:checked), .audit__selector label:has(input:checked) { border-color: var(--family-accent); background: color-mix(in srgb, var(--family-accent), transparent 84%); }
  .audit__choices input, .audit__selector input { grid-row: 1 / 3; inline-size: 1.35rem; block-size: 1.35rem; accent-color: var(--presentation-ink); }
  .audit__selector input { grid-row: 1; }
  .audit__choices span, .audit__selector span { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.9rem; }
  .audit__choices strong, .audit__selector strong { font-size: 1rem; line-height: 1.15; }
  .audit__classification button, .audit__statements button { justify-self: start; min-block-size: 2.75rem; padding: .45rem .95rem; border: 1px solid var(--presentation-ink); background: var(--presentation-ink); color: var(--presentation-surface); font: 700 0.95rem var(--font-display); }
  .audit__classification button:disabled, .audit__statements button:disabled { opacity: .45; cursor: not-allowed; }
  .audit__classification output { padding: .55rem .7rem; border-inline-start: .3rem solid var(--family-accent); background: var(--presentation-surface); font-size: .85rem; font-weight: 680; }
  .audit__classification details { font-size: .82rem; }
  .audit__classification details p { margin: .3rem 0 0; }

  .audit__statements { display: grid; gap: .35rem; align-content: center; min-block-size: 0; }
  .audit__statements header { display: flex; justify-content: space-between; gap: 1rem; align-items: end; }
  .audit__statements header p { margin: 0; }
  .audit__notice, .audit__reveal-status { margin: 0; color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.82rem; }
  .audit__statements ol { display: grid; grid-template-columns: 1fr; margin: 0; padding: 0; list-style: none; }
  .audit__statements li { display: grid; grid-template-columns: 1.7rem 1fr; gap: .1rem .5rem; min-block-size: 2.7rem; padding: .35rem .25rem; border-block-start: 1px solid var(--presentation-line); }
  .audit__number { grid-row: 1 / 3; color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.82rem; }
  .audit__statements strong { font-size: 0.98rem; line-height: 1.2; }
  .audit__statements small { color: color-mix(in srgb, var(--presentation-ink), var(--family-accent) 42%); font-family: var(--font-mono); font-size: 0.82rem; font-weight: 760; }

  .audit__selector { align-content: center; }
  .audit__explorer .audit__selector legend { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .audit__panels { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  [data-enhanced='true'] .audit__panels { grid-template-columns: 1fr; }
  .audit__panels article { display: grid; gap: .25rem; align-content: center; min-block-size: 5.2rem; padding: .65rem .8rem; border: 1px solid var(--presentation-line); border-block-start: .3rem solid var(--family-accent); background: var(--presentation-surface); }
  .audit__panels h3, .audit__risk header h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1rem, .85rem + .45vw, 1.3rem); }
  .audit__panels p, .audit__risk header p { margin: 0; font-size: .95rem; line-height: 1.25; }
  .audit__risk { grid-template-rows: auto 1fr; }
  .audit__risk header { grid-column: 1 / -1; }
  .audit__risk .audit__selector { grid-template-columns: repeat(3, 1fr); }
  .audit__risk .audit__selector legend { grid-column: 1 / -1; }
  .audit__panels--risk article { min-block-size: 6rem; }
  .audit__method { grid-template-rows: 1fr auto; }
  .audit__output { grid-column: 1 / -1; display: flex; gap: .7rem; margin: 0; padding-inline-start: .7rem; border-inline-start: .3rem solid var(--family-accent); font-size: .85rem; font-weight: 680; }
  .audit__output span { color: var(--presentation-muted); font-family: var(--font-mono); }
  [data-audit-panel][hidden], [data-statement-category][hidden], [data-classification-result][hidden] { display: none !important; }

  @media (max-width: 52rem) {
    .audit__classification, .audit__explorer, .audit__risk, .audit__method { grid-template-columns: 1fr; }
    .audit__risk header, .audit__output { grid-column: 1; }
    .audit__statements ol { grid-template-columns: 1fr; }
    .audit__risk .audit__selector { grid-template-columns: 1fr; }
  }
</style>
