---
import type { RoutedSlide } from '../../../../presentation/presentation-model';
import SceneFrame from '../../scenes/SceneFrame.astro';

interface Surface {
  name: string;
  use: string;
  context: string;
  action: string;
  control?: string;
}

interface Task {
  task: string;
  minimum: string;
  reason: string;
}

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
const baseSurfaces: Surface[] = [
  { name: 'Chat', use: 'Réfléchir et cadrer', context: 'Conversation', action: 'Texte' },
  { name: 'Artifacts', use: 'Prototyper', context: 'Conversation + objet', action: 'Création visible' },
  { name: 'Cowork', use: 'Traiter des ressources', context: 'Dossier + outils', action: 'Travail multiétape' },
  { name: 'Claude Code', use: 'Modifier un projet', context: 'Fichiers + terminal', action: 'Code, commandes, tests' },
];
const supplied = Array.isArray(data.surfaces) ? data.surfaces as Surface[] : [];
const tasks = Array.isArray(data.tasks) ? data.tasks as Task[] : [];
const surfaces = baseSurfaces.map((base) => {
  const detailed = supplied.find((surface) => surface.name === base.name);
  const task = tasks.find((item) => item.minimum === base.name);
  return {
    ...base,
    ...detailed,
    use: task?.task ?? detailed?.use ?? base.use,
    control: task?.reason ?? String(data.rule ?? base.use),
  };
});
const target = typeof data.target === 'string' ? data.target : surfaces[0].name;
const activeIndex = Math.max(0, surfaces.findIndex((surface) => surface.name === target));
const detailsId = `${slide.id}-surface-details`;
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class="interface-continuum"
>
  <div class="continuum__scene" data-continuum>
    <fieldset class="continuum__range" aria-describedby={detailsId}>
      <legend>{String(data.interaction ?? 'Explorer le continuum des interfaces')}</legend>
      <div class="continuum__track" aria-hidden="true"></div>
      {surfaces.map((surface, index) => (
        <label>
          <input
            type="radio"
            name={`${slide.id}-surface`}
            value={String(index)}
            checked={index === activeIndex}
            disabled
            data-surface-choice
          />
          <span class="continuum__point" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{surface.name}</strong>
          <small>{surface.use}</small>
        </label>
      ))}
    </fieldset>

    <section id={detailsId} class="continuum__details" aria-live="polite">
      {surfaces.map((surface, index) => (
        <article data-surface-panel={index}>
          <p class="scene-label">Surface minimale suffisante</p>
          <h2>{surface.name}</h2>
          {typeof data.need === 'string' && <p class="continuum__need">Besoin · {data.need}</p>}
          <dl>
            <div><dt>Contexte</dt><dd>{surface.context}</dd></div>
            <div><dt>Action</dt><dd>{surface.action}</dd></div>
            <div><dt>Contrôle</dt><dd>{surface.control}</dd></div>
          </dl>
        </article>
      ))}
    </section>

    <p class="continuum__axis">
      <span>{typeof data.axes === 'object' && data.axes && 'vertical' in data.axes ? String(data.axes.vertical) : 'Contexte disponible'}</span>
      <span aria-hidden="true">→</span>
      <span>{typeof data.axes === 'object' && data.axes && 'horizontal' in data.axes ? String(data.axes.horizontal) : "Capacité d'action"}</span>
    </p>
  </div>
</SceneFrame>

<script>
  document.querySelectorAll<HTMLElement>('[data-continuum]').forEach((scene) => {
    const choices = Array.from(scene.querySelectorAll<HTMLInputElement>('[data-surface-choice]'));
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-surface-panel]'));
    scene.dataset.enhanced = 'true';

    choices.forEach((choice) => {
      choice.disabled = false;
      choice.addEventListener('change', () => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.surfacePanel !== choice.value; });
      });
    });
    const active = choices.find((choice) => choice.checked)?.value ?? '0';
    panels.forEach((panel) => { panel.hidden = panel.dataset.surfacePanel !== active; });
  });
</script>

<style>
  .continuum__scene {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    grid-template-rows: 1fr;
    gap: 0.75rem clamp(1.2rem, 3vw, 3rem);
    align-items: center;
    min-block-size: 0;
  }

  .continuum__range {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    margin: 0;
    padding: 1rem 0 0;
    border: 0;
  }

  .continuum__range legend {
    position: absolute;
    inset-block-start: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.75rem + 0.1vw, 0.78rem);
    font-weight: 720;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .continuum__track {
    position: absolute;
    inset-block-start: 2.15rem;
    inset-inline: 8%;
    block-size: 0.28rem;
    background: linear-gradient(90deg, var(--presentation-line), var(--family-accent));
  }

  .continuum__range label {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem;
    align-items: center;
    justify-items: start;
    min-block-size: 2.4rem;
    padding: 0.1rem;
    cursor: pointer;
    text-align: start;
  }

  .continuum__range input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .continuum__point {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    aspect-ratio: 1;
    border: 2px solid var(--presentation-ink);
    border-radius: 50%;
    background: var(--presentation-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: transform 180ms ease, background 180ms ease;
  }

  .continuum__range input:checked + .continuum__point {
    border-width: 0.32rem;
    background: var(--family-accent);
    transform: translateY(-0.3rem);
  }

  .continuum__range input:focus-visible + .continuum__point {
    outline: 0.22rem solid var(--presentation-focus);
    outline-offset: 0.22rem;
  }

  .continuum__range strong { font-family: var(--font-display); font-size: clamp(0.78rem, 0.75rem + 0.18vw, 0.9rem); }
  .continuum__range small {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .continuum__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    padding-inline-start: clamp(0.9rem, 2vw, 1.6rem);
    border-inline-start: 0.35rem solid var(--family-accent);
  }

  [data-enhanced='true'] .continuum__details { grid-template-columns: 1fr; }
  .continuum__details article { display: grid; gap: .05rem; padding: .25rem; border: 1px solid var(--presentation-line); }
  [data-enhanced='true'] .continuum__details article { padding: 0; border: 0; }
  .continuum__details article[hidden] { display: none; }

  .continuum__details .scene-label { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .continuum__details h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1rem, .9rem + .35vw, 1.3rem); line-height: 1; }
  .continuum__need { margin: 0; color: var(--presentation-muted); font-size: 0.75rem; }
  .continuum__details dl { display: grid; gap: 0.12rem; margin: 0; }
  .continuum__details dl { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .continuum__details dl div { display: grid; gap: 0.1rem; padding-block-start: 0.18rem; border-block-start: 1px solid var(--presentation-line); }
  .continuum__details dt { color: var(--presentation-muted); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; }
  .continuum__details dd { margin: 0; font-size: 0.75rem; font-weight: 650; line-height: 1.08; }

  .continuum__axis {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .continuum__axis span[aria-hidden] { flex: 1; color: var(--presentation-ink); text-align: center; }

  @media (max-width: 52rem) {
    .continuum__scene { grid-template-columns: 1fr; }
    .continuum__details { padding-block-start: 1rem; padding-inline-start: 0; border-block-start: 0.35rem solid var(--family-accent); border-inline-start: 0; }
  }

  @media (max-width: 38rem) {
    .continuum__range { grid-template-columns: 1fr 1fr; }
    .continuum__track { display: none; }
    .continuum__range label { grid-template-columns: 1fr; justify-items: center; min-block-size: 7rem; text-align: center; }
    .continuum__range small { position: static; inline-size: auto; block-size: auto; overflow: visible; clip-path: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .continuum__point { transition: none; }
    .continuum__range input:checked + .continuum__point { transform: none; }
  }
</style>
