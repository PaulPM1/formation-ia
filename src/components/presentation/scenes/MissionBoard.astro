---
import type { RoutedSlide } from '../../../presentation/presentation-model';
import {
  MISSION_FIELD_GROUPS,
  partitionSceneFields,
} from '../../../presentation/scene-data';
import SceneFrame from './SceneFrame.astro';

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
const partition = partitionSceneFields(data, MISSION_FIELD_GROUPS);
const interaction = partition.groups.interaction[0];
const instruction = partition.groups.instruction[0];
const steps = partition.groups.steps.flatMap((field) => field.values);
const deliverables = partition.groups.deliverables;
const successCriterion = partition.groups.success[0];
const duration = `${slide.speaker.durationMinutes} min`;
const statements = Array.isArray(data.statements)
  ? data.statements.flatMap((statement) => (
    statement && typeof statement === 'object' && !Array.isArray(statement)
      ? [{
        text: String((statement as Record<string, unknown>).text ?? ''),
        category: String((statement as Record<string, unknown>).category ?? ''),
      }]
      : []
  )).filter((statement) => statement.text)
  : [];
const details = partition.details.filter((detail) => detail.key !== 'statements');
const missionClass = statements.length > 0
  ? 'mission-board mission-board--statements'
  : 'mission-board';
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class={missionClass}
>
  <header class="mission-board__header">
    <p class="scene-label">Mission{interaction && ` · ${interaction.values.join(' · ')}`}</p>
    <p class="mission-board__duration"><span>Durée</span> <strong>{duration}</strong></p>
  </header>

  <div class="mission-board__actions">
    {instruction && <p class="mission-board__instruction">{instruction.values.join(' · ')}</p>}
    <ol class="mission-board__steps">
      {steps.map((step) => <li>{step}</li>)}
    </ol>
  </div>

  <dl class="mission-board__outcome">
    {deliverables.length > 0
      ? deliverables.map((field) => (
        <div>
          <dt>{field.label}</dt>
          <dd>
            {field.values.length > 1
              ? <ul>{field.values.map((value) => <li>{value}</li>)}</ul>
              : field.values[0]}
          </dd>
        </div>
      ))
      : statements.length === 0 && (
        <div>
          <dt>Livrable</dt>
          <dd>Un résultat transmissible conforme au critère de réussite.</dd>
        </div>
      )}
    <div>
      <dt>{successCriterion?.label ?? 'Réussite'}</dt>
      <dd>{successCriterion?.values[0] ?? slide.support ?? slide.accessibleDescription}</dd>
    </div>
    {details.map((detail) => (
      <div>
        <dt>{detail.label}</dt>
        <dd>
          {detail.values.length > 1
            ? <ul>{detail.values.map((value) => <li>{value}</li>)}</ul>
            : detail.values[0]}
        </dd>
      </div>
    ))}
    {statements.length > 0 && (
      <div class="mission-board__statements">
        <dt>Énoncés à traiter</dt>
        <dd>
          <ol>
            {statements.map((statement, index) => (
              <li>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <strong>{statement.text}</strong>
              </li>
            ))}
          </ol>
          <details class="mission-board__correction">
            <summary>Afficher la correction</summary>
            <ol class="mission-board__correction-list">
              {statements.map((statement, index) => (
                <li>
                  <span>Affirmation {index + 1}</span>
                  <p>{statement.text}</p>
                  <strong>{statement.category}</strong>
                </li>
              ))}
            </ol>
          </details>
        </dd>
      </div>
    )}
  </dl>
</SceneFrame>
