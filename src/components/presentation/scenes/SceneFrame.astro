---
interface Props {
  title: string;
  description: string;
  visualKey: string;
  class?: string;
}

const {
  title,
  description,
  visualKey,
  class: className = '',
} = Astro.props;
---

<figure class:list={['presentation-visual', 'scene-frame', className]} data-visual-key={visualKey}>
  <div class="scene-frame__content">
    <slot />
  </div>
  <figcaption>
    <strong>{title}</strong>
    <span>{description}</span>
  </figcaption>
</figure>
