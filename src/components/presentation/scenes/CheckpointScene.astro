---
import type { RoutedSlide } from '../../../presentation/presentation-model';
import {
  CHECKPOINT_FIELD_GROUPS,
  partitionSceneFields,
} from '../../../presentation/scene-data';
import SceneFrame from './SceneFrame.astro';

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;
const data = slide.visual.data;
const partition = partitionSceneFields(data, CHECKPOINT_FIELD_GROUPS);
const interaction = partition.groups.interaction[0];
const checks = partition.groups.checklist.flatMap((field) => field.values);
const successCriterion = partition.groups.criterion[0];
const details = partition.details;
---

<SceneFrame
  title={slide.claim}
  description={slide.accessibleDescription}
  visualKey={slide.visual.key}
  class="checkpoint-scene"
>
  <fieldset class="checkpoint-scene__checklist">
    <legend>{interaction?.values[0] ?? 'Checkpoint · éléments à vérifier'}</legend>
    <ul>
      {checks.map((check, index) => (
        <li>
          <input id={`${slide.id}-check-${index}`} type="checkbox" />
          <label for={`${slide.id}-check-${index}`}>{check}</label>
          <span class="checkpoint-scene__status">À vérifier</span>
        </li>
      ))}
    </ul>
  </fieldset>
  <div class="checkpoint-scene__outcome">
    <p class="checkpoint-scene__criterion">
      <strong>{successCriterion?.label ?? 'Validation'} :</strong>
      {' '}{successCriterion?.values[0] ?? slide.support ?? slide.accessibleDescription}
    </p>
    {details.length > 0 && (
      <dl class="checkpoint-scene__details">
        {details.map((detail) => (
          <div>
            <dt>{detail.label}</dt>
            <dd>
              {detail.values.length > 1
                ? <ul>{detail.values.map((value) => <li>{value}</li>)}</ul>
                : detail.values[0]}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</SceneFrame>
