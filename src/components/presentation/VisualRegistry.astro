---
import type { RoutedSlide, SlideVisualKey } from '../../presentation/presentation-model';
import DemoScene from './scenes/DemoScene.astro';
import QuizScene from './scenes/QuizScene.astro';
import SortScene from './scenes/SortScene.astro';
import VisualScene from './scenes/VisualScene.astro';

interface Props {
  slide: RoutedSlide;
}

const { slide } = Astro.props;

// `cover` n'a pas de scène : le titre occupe toute la slide.
const sceneRegistry = {
  cover: null,
  visual: VisualScene,
  quiz: QuizScene,
  sort: SortScene,
  demo: DemoScene,
} satisfies Record<SlideVisualKey, unknown>;

const Scene = sceneRegistry[slide.visual.key];
---

{Scene && <Scene slide={slide} />}
