---
// Ce que Claude voit (la conversation, les fichiers du dossier, CLAUDE.md) et
// ce qu'il ne voit pas (ce qui reste dans votre tête). Schéma au style du site.
import './claude-app.css';
import Icon from './Icon.astro';
---

<figure class="ca-figure is-narrow wcs">
  <div class="wcs-pair">
    <div class="wcs-in">
      <p class="wcs-title">Claude voit</p>
      <ul>
        <li><Icon name="chat" />Cette conversation</li>
        <li><Icon name="folder" />Les fichiers du dossier</li>
        <li><Icon name="file" />CLAUDE.md</li>
      </ul>
    </div>
    <div class="wcs-out">
      <p class="wcs-title">Claude ne voit pas</p>
      <ul>
        <li>Ce que vous avez en tête</li>
        <li>Vos autres conversations</li>
        <li>Ce qui vous paraît évident</li>
      </ul>
    </div>
  </div>
</figure>

<style>
  .wcs-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .wcs-pair > div {
    padding: 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .wcs .wcs-in {
    background: var(--family-accent);
    box-shadow: var(--shadow-block);
  }

  .wcs .wcs-out {
    border-style: dashed;
    color: var(--muted);
  }

  .wcs .wcs-title {
    margin: 0 0 0.7rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: var(--weight-display);
    line-height: 1.2;
  }

  .wcs ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wcs ul li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.95rem;
    font-weight: var(--weight-semibold);
    line-height: 1.35;
  }

  .wcs .wcs-in li {
    padding: 0.4rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .wcs .wcs-out li { font-weight: var(--weight-medium); }
  .wcs .wcs-out li::before { content: "?"; font-family: var(--font-display); font-weight: 800; }

  @media (max-width: 30rem) {
    .wcs-pair { grid-template-columns: minmax(0, 1fr); }
  }
</style>
