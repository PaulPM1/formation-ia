---
// Visuel principal de la brique C1 : Claude ne connaît d'abord que la
// description d'un skill, puis ouvre le reste quand la demande s'y prête.
import ClaudeApp from './ClaudeApp.astro';
import Composer from './Composer.astro';
import Icon from './Icon.astro';
import StepRail from './StepRail.astro';

const steps = [
  { label: 'Vous demandez', text: 'Vous nommez le skill, ou vous décrivez simplement ce que vous voulez faire.' },
  { label: 'Claude le reconnaît', text: 'Il ne connaît d’abord que la description : elle lui dit quand ce skill sert.' },
  { label: 'Il suit la méthode', text: 'Il ouvre alors le reste du fichier et l’applique, étape par étape.' },
];
---

<figure class="ca-figure skl" data-stepper data-step="3">
  <ClaudeApp title="New session">
    <div class="ca-split">
      <div class="ca-talk">
        <div class="ca-thread">
          <p class="ca-you">J’ai une idée de site. Lance setup-projet.</p>
          <div class="ca-claude from-2">
            <p class="ca-tool"><i></i>Skill <b>setup-projet</b></p>
            <p class="ca-say from-3">Racontez-moi votre idée, comme vous la raconteriez à un ami.</p>
          </div>
        </div>
        <Composer placeholder="Reply to Claude" />
      </div>

      <div class="ca-pane">
        <p class="ca-pane-bar"><Icon name="file" /><span>setup-projet / SKILL.md</span></p>
        <div class="skl-file">
          <div class="skl-desc">
            <p class="skl-h">description</p>
            <p>Cadre un projet à partir d’une simple idée. À utiliser quand la personne veut démarrer son projet.</p>
          </div>
          <div class="skl-body">
            <p class="skl-h">La méthode</p>
            <p>1. Interview en trois temps.</p>
            <p>2. Découpage en fonctionnalités.</p>
            <p>3. Écriture des fichiers de suivi.</p>
            <p class="skl-h">À ne pas faire</p>
            <p>Construire pendant le cadrage.</p>
          </div>
        </div>
      </div>
    </div>
  </ClaudeApp>
  <StepRail steps={steps} />
</figure>

<style>
  @media (min-width: 40.01rem) {
    .skl :global(.ca-split) { block-size: 21rem; }
  }

  .skl-file {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .skl-desc,
  .skl-body {
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    transition: opacity 0.5s ease, box-shadow 0.5s ease;
  }

  .skl .skl-file .skl-h {
    margin-block: 0.7rem 0.15rem;
    color: var(--app-accent);
    font-weight: 600;
  }

  .skl .skl-file .skl-h:first-child { margin-block-start: 0; }

  /* Étape 1 : rien n'est lu. Étape 2 : la description seule. Étape 3 : tout. */
  .skl[data-step="1"] .skl-desc,
  .skl:not([data-step="3"]) .skl-body { opacity: 0.3; }
  .skl[data-step="2"] .skl-desc,
  .skl[data-step="3"] .skl-body { box-shadow: inset 0 0 0 2px var(--app-accent); }
</style>
