---
// À quoi sert Design : quatre choses qu'on peut lui faire dessiner. Chaque
// tuile porte un petit croquis fait en CSS, au style du site.
---

<figure class="ca-figure dsu">
  <div class="dsu-grid">
    <div>
      <p class="dsu-draw dsu-site" aria-hidden="true"><i></i><i></i><i></i><i></i></p>
      <p><b>Une maquette de site</b>La page d’accueil avant de la construire.</p>
    </div>
    <div>
      <p class="dsu-draw dsu-logo" aria-hidden="true"><i></i><i></i><i></i></p>
      <p><b>Un logo</b>Plusieurs pistes, côte à côte.</p>
    </div>
    <div>
      <p class="dsu-draw dsu-deck" aria-hidden="true"><i></i><i></i><i></i></p>
      <p><b>Une présentation</b>Des diapositives, exportables en PowerPoint.</p>
    </div>
    <div>
      <p class="dsu-draw dsu-phone" aria-hidden="true"><i></i></p>
      <p><b>Un écran d’application</b>Ce que l’on verra sur le téléphone.</p>
    </div>
  </div>
</figure>

<style>
  .dsu-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .dsu-grid > div {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-block);
  }

  .dsu-grid p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .dsu-grid b {
    display: block;
    margin-block-end: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.15;
  }

  /* Le cadre du croquis, commun aux quatre tuiles. */
  .dsu-grid .dsu-draw {
    display: grid;
    place-content: center;
    block-size: 7rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--paper);
    line-height: 0;
  }

  .dsu-draw i { display: block; border: 2px solid var(--ink); border-radius: 3px; }

  /* Site : un bandeau, une grande image, deux colonnes. */
  .dsu-site { grid-template-columns: 3rem 3rem; gap: 0.3rem; }
  .dsu-site i:nth-child(1) { grid-column: 1 / -1; block-size: 0.6rem; background: var(--ink); }
  .dsu-site i:nth-child(2) { grid-column: 1 / -1; block-size: 2.2rem; background: var(--family-accent); }
  .dsu-site i:nth-child(n + 3) { block-size: 1.2rem; }

  /* Logo : trois pistes. */
  .dsu-logo { grid-auto-flow: column; gap: 0.6rem; align-items: center; }
  .dsu-logo i { inline-size: 2.2rem; block-size: 2.2rem; background: var(--family-accent); }
  .dsu-logo i:nth-child(1) { border-radius: 50%; }
  .dsu-logo i:nth-child(2) { rotate: 45deg; scale: 0.8; background: var(--brick-yellow); }
  .dsu-logo i:nth-child(3) { border-radius: 50% 50% 4px 50%; background: var(--brick-blue); }

  /* Présentation : trois diapositives empilées. */
  .dsu-deck i { grid-area: 1 / 1; inline-size: 5.5rem; block-size: 3.4rem; background: var(--surface); }
  .dsu-deck i:nth-child(1) { translate: 0.9rem -0.7rem; }
  .dsu-deck i:nth-child(2) { translate: 0.45rem -0.35rem; }
  .dsu-deck i:nth-child(3) { background: var(--family-accent); }

  /* Téléphone : un cadre haut, une image, un bouton. */
  .dsu-phone i {
    inline-size: 3.2rem;
    block-size: 5.6rem;
    border-radius: 10px;
    background:
      linear-gradient(var(--family-accent), var(--family-accent)) 50% 0.5rem / 2.2rem 2rem no-repeat,
      linear-gradient(var(--ink), var(--ink)) 50% 4.1rem / 1.8rem 0.6rem no-repeat,
      var(--surface);
  }

  @media (max-width: 56rem) {
    .dsu-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 30rem) {
    .dsu-grid { gap: 0.9rem; }
    .dsu-grid > div { padding: 0.7rem; }
  }
</style>
