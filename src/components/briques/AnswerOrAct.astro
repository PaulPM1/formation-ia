---
// Répondre contre agir : une réponse s'arrête après un aller-retour, un agent
// enchaîne des actions et regarde leur résultat jusqu'à ce que ce soit fait.
---

<figure class="ca-figure is-narrow aoa">
  <div class="aoa-row">
    <p class="aoa-name">Répondre</p>
    <p class="aoa-flow"><span>Vous demandez</span><i></i><span>Claude répond</span></p>
    <p class="aoa-end">La suite est à vous.</p>
  </div>
  <div class="aoa-row is-agent">
    <p class="aoa-name">Agir</p>
    <p class="aoa-flow">
      <span>Vous demandez</span><i></i>
      <span class="aoa-loop"><b>Il agit</b><i></i><b>Il regarde le résultat</b><i></i><b>Il corrige</b></span>
    </p>
    <p class="aoa-end">Il recommence jusqu’à ce que ce soit fait. C’est un agent.</p>
  </div>
</figure>

<style>
  .aoa {
    display: grid;
    gap: 1.2rem;
  }

  .aoa-row {
    padding: 0.9rem 1rem 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .aoa-row.is-agent { box-shadow: var(--shadow-block); }

  .aoa .aoa-name {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: var(--weight-display);
  }

  .aoa .aoa-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.9rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .aoa-flow > span:not(.aoa-loop),
  .aoa-loop b {
    padding: 0.3rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .aoa-loop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem;
    border: 2px dashed var(--ink);
    border-radius: var(--radius-md);
  }

  .aoa .aoa-loop b { background: var(--family-accent); }

  /* Flèche */
  .aoa-flow i {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border: solid var(--ink);
    border-width: 2px 2px 0 0;
    rotate: 45deg;
    margin-inline-end: 0.2rem;
  }

  .aoa .aoa-end {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }
</style>
