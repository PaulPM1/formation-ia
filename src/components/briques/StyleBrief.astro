---
// Visuel principal de la brique E2 : décrire l'allure voulue avec des mots et
// une capture jointe, demander trois versions, les comparer dans l'aperçu.
import ClaudeApp from './ClaudeApp.astro';
import Composer from './Composer.astro';
import Icon from './Icon.astro';
---

<figure class="ca-figure sb">
  <ClaudeApp title="Recettes de famille" session="Recettes de famille">
    <div class="ca-split">
      <div class="ca-talk">
        <div class="ca-thread">
          <p class="sb-file"><Icon name="file" />carnet-de-cuisine.png<span class="ca-pin">1</span></p>
          <p class="ca-you">L’allure d’un carnet de cuisine, chaleureux. Propose-moi trois versions.<span class="ca-pin">2</span></p>
          <div class="ca-claude">
            <p class="ca-tool"><i></i>Wrote 3 files</p>
            <p class="ca-say">Voici trois versions dans l’aperçu. Laquelle gardez-vous ?</p>
          </div>
        </div>
        <Composer placeholder="Reply to Claude" />
      </div>
      <div class="ca-pane">
        <p class="ca-pane-bar"><span>Preview</span><em>localhost:3000</em></p>
        <div class="sb-versions">
          <span class="ca-pin">3</span>
          <div class="sb-v sb-v1"><b>1</b><p>Recettes de famille</p><i></i><i></i></div>
          <div class="sb-v sb-v2"><b>2</b><p>Recettes de famille</p><i></i><i></i></div>
          <div class="sb-v sb-v3"><b>3</b><p>Recettes de famille</p><i></i><i></i></div>
        </div>
      </div>
    </div>
  </ClaudeApp>
  <ol class="ca-legend">
    <li><span>Un exemple joint</span></li>
    <li><span>Des mots simples</span></li>
    <li><span>Plusieurs versions à comparer</span></li>
  </ol>
</figure>

<style>
  @media (min-width: 40.01rem) {
    .sb :global(.ca-split) { block-size: 22rem; }
  }

  /* Les repères s'accrochent à l'élément qu'ils désignent. */
  .sb .sb-file,
  .sb :global(.ca-you),
  .sb-versions { position: relative; }

  .sb :global(.ca-thread) { overflow: visible; }

  .sb .sb-file .ca-pin,
  .sb :global(.ca-you .ca-pin) {
    inset: 50% auto auto -2.2rem;
    transform: translateY(-50%);
  }

  .sb-versions .ca-pin { inset: 0.4rem 0.4rem auto auto; }

  .sb .sb-file {
    display: flex;
    align-items: center;
    align-self: flex-end;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--app-line);
    border-radius: 8px;
    color: var(--app-soft);
    font-size: 0.74rem;
  }

  .sb-versions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 0.8rem;
    background: #ecebe6;
  }

  .sb-v {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.6rem 0.6rem 0.7rem;
    border-radius: 8px;
    background: #fbe8cf;
    color: #1d1d1b;
  }

  .sb .sb-v p {
    font-family: var(--app-serif);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .sb-v b {
    position: absolute;
    inset: 0.4rem auto auto 0.5rem;
    font-size: 0.68rem;
    opacity: 0.6;
  }

  .sb-v i {
    block-size: 4.6rem;
    border-radius: 6px;
    background: linear-gradient(135deg, #f2c26b, #d98a3d);
  }

  .sb-v i:last-child { background: linear-gradient(135deg, #e9a06b, #b5532c); }

  /* Version 2 : sombre et sobre. Version 3 : claire, photos rondes. */
  .sb-v2 { background: #23302b; color: #f7f4ed; }
  .sb .sb-v2 p { font-family: var(--app-sans); letter-spacing: 0.02em; text-transform: uppercase; font-size: 0.72rem; }
  .sb-v2 i { border-radius: 0; }
  .sb-v3 { background: #fff; justify-items: center; text-align: center; }
  .sb-v3 i { inline-size: 4.6rem; border-radius: 50%; }
</style>
