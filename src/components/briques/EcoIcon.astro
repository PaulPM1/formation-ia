} as const;

const GITHUB = '<path fill="currentColor" stroke="none" d="M8 0C3.580 0 0 3.580 0 8c0 3.540 2.290 6.530 5.470 7.590.4.070.550-.170.550-.380 0-.190-.010-.820-.010-1.490-2.010.370-2.530-.490-2.690-.940-.090-.230-.480-.940-.820-1.130-.280-.150-.680-.520-.010-.530.630-.010 1.080.580 1.230.820.720 1.210 1.870.870 2.330.660.070-.520.280-.870.510-1.070-1.780-.200-3.640-.890-3.640-3.950 0-.870.310-1.590.820-2.150-.080-.200-.360-1.020.080-2.120 0 0 .670-.210 2.200.820.640-.180 1.320-.270 2-.270s1.360.090 2 .270c1.530-1.040 2.200-.820 2.200-.820.440 1.100.160 1.920.080 2.120.510.560.820 1.270.820 2.150 0 3.070-1.870 3.750-3.650 3.950.290.250.540.730.540 1.480 0 1.070-.010 1.930-.010 2.200 0 .210.150.460.550.380A8.010 8.010 0 0 0 16 8c0-4.420-3.580-8-8-8z"/>';
const VERCEL = '<path fill="currentColor" stroke="none" d="M12 4 21.500 20h-19z"/>';

interface Props {
  name: keyof typeof SHAPES | 'github' | 'vercel';
}
const { name } = Astro.props;
const viewBox = name === 'github' ? '0 0 16 16' : '0 0 24 24';
const shape = name === 'github' ? GITHUB : name === 'vercel' ? VERCEL : SHAPES[name];
---

<svg class="eco-icon" viewBox={viewBox} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={shape} />
