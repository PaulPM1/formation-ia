---
// Visuel principal de la brique B2 : la boucle demander, construire, regarder,
// corriger, jouée dans l'onglet Code.
import ClaudeApp from './ClaudeApp.astro';
import Composer from './Composer.astro';
import StepRail from './StepRail.astro';

const steps = [
  { label: 'Vous demandez', text: 'Vous décrivez ce que vous voulez, avec vos mots.' },
  { label: 'Claude construit', text: 'Il écrit les fichiers, puis demande la permission de lancer le projet.' },
  { label: 'Vous regardez', text: 'Le résultat s’affiche dans l’aperçu. Aucun code à lire.' },
  { label: 'Vous corrigez', text: 'Vous dites ce qui ne va pas. Il corrige, et la boucle reprend.' },
];
---

<figure class="ca-figure cc-loop" data-stepper data-step="4">
  <ClaudeApp title="Page recettes de famille" session="Page recettes de famille">
    <div class="ca-split">
      <div class="ca-talk">
        <div class="ca-thread">
          <p class="ca-you">Crée une page qui présente mes recettes de famille.</p>
          <div class="ca-claude from-2">
            <p class="ca-say">Je crée la page et je vous la montre.</p>
            <p class="ca-tool"><i></i>Read <b>mes-recettes</b></p>
            <p class="ca-tool"><i></i>Wrote <b>index.html</b> and 2 more</p>
            <div class="ca-ask only-2">
              <p>Allow Claude to start the project?</p>
              <p class="ca-ask-buttons"><em>Deny</em><em class="is-yes">Allow once</em></p>
            </div>
            <p class="ca-tool from-3"><i></i>Started <b>preview</b></p>
          </div>
          <p class="ca-you from-4">Les photos plus grandes, et un fond plus chaud.</p>
          <div class="ca-claude from-4">
            <p class="ca-tool"><i></i>Edited <b>style.css</b></p>
            <p class="ca-say">C’est fait, regardez l’aperçu.</p>
          </div>
        </div>
        <Composer placeholder="Reply to Claude" />
      </div>

      <div class="ca-pane">
        <p class="ca-pane-bar"><span>Preview</span><em>localhost:3000</em></p>
        <p class="ca-pane-empty until-2">Nothing to preview yet</p>
        <div class="cc-page from-3 ca-enter">
          <p class="cc-page-title">Recettes de famille</p>
          <div class="cc-dishes">
            <div><i></i><span>Gratin de mamie</span></div>
            <div><i></i><span>Tarte aux pommes</span></div>
            <div><i></i><span>Soupe au pistou</span></div>
          </div>
        </div>
      </div>
    </div>
  </ClaudeApp>
  <StepRail steps={steps} />
</figure>

<style>
  /* La page construite : c'est le projet de la personne, donc claire et sans
     rapport avec le thème de l'application. */
  .cc-page {
    padding: 1.4rem 1.3rem;
    background: #fff;
    color: #1d1d1b;
    transition: background-color 0.7s ease;
  }

  .cc-loop .cc-page .cc-page-title {
    margin-block-end: 1rem;
    font-family: var(--app-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .cc-dishes { display: grid; gap: 0.65rem; }

  .cc-dishes div {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .cc-dishes i {
    flex: none;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #f2c26b, #d98a3d);
    transition: inline-size 0.7s ease, block-size 0.7s ease;
  }

  .cc-dishes div:nth-child(2) i { background: linear-gradient(135deg, #e9a06b, #b5532c); }
  .cc-dishes div:nth-child(3) i { background: linear-gradient(135deg, #a9c98a, #5f8f4e); }

  /* Étape 4 : la correction se voit, les photos grandissent et le fond change. */
  .cc-loop[data-step="4"] .cc-page { background: #fbe8cf; }
  .cc-loop[data-step="4"] .cc-dishes i {
    inline-size: 4.2rem;
    block-size: 4.2rem;
  }
</style>
