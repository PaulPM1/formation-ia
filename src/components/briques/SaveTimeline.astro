---
// La frise des sauvegardes de la brique D2 : chaque sauvegarde est un point
// où l'on peut revenir quand une modification casse le projet.
import './claude-app.css';
import './eco.css';
import StepRail from './StepRail.astro';

const steps = [
  { label: 'Des points de sauvegarde', text: 'Chaque sauvegarde garde le projet tel qu’il était à ce moment-là.' },
  { label: 'Un changement casse tout', text: 'Cela arrive à tout le monde. Rien n’est perdu : les sauvegardes sont toujours là.' },
  { label: 'Vous revenez en arrière', text: 'Vous demandez à Claude de revenir à la dernière sauvegarde qui marchait.' },
];
const saves = ['Page d’accueil', 'Fiche d’une recette', 'Photos des plats'];
---

<figure class="ca-figure tl" data-stepper data-step="3">
  <div class="tl-stage" aria-hidden="true">
    <ol class="tl-line">
      {saves.map((save, index) => (
        <li class:list={{ 'tl-good': index === saves.length - 1 }}><i></i><span>{save}</span></li>
      ))}
      <li class="tl-bad"><i></i><span>Nouveau menu</span></li>
    </ol>
    <p class="tl-here">Votre projet est ici</p>
    <p class="tl-back">Reviens à la dernière sauvegarde qui marchait.</p>
  </div>
  <StepRail steps={steps} />
</figure>

<style>
  .tl-stage {
    position: relative;
    padding: 4.2rem 1rem 1.4rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-block);
    margin: 0 6px 6px 0;
  }

  .tl .tl-line {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl .tl-line li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transition: opacity 0.5s ease;
  }

  /* Le trait qui relie un point au suivant. */
  .tl-line li + li::before {
    position: absolute;
    inset: 0.65rem 50% auto -50%;
    block-size: 4px;
    background: var(--ink);
    content: "";
  }

  .tl-line i {
    position: relative;
    z-index: 1;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--family-accent);
    transition: background-color 0.5s ease, transform 0.5s ease;
  }

  .tl-bad i { background: var(--brick-coral); }
  .tl-bad i::after {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink);
    font-style: normal;
    font-weight: 800;
    content: "×";
  }

  /* L'étiquette « Votre projet est ici » suit le point courant. */
  .tl .tl-here {
    position: absolute;
    inset: 1.1rem auto auto 62.5%;
    margin: 0;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--brick-yellow);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    transform: translateX(-50%);
    transition: inset-inline-start 0.7s ease;
  }

  .tl-here::after {
    position: absolute;
    inset: 100% auto auto 50%;
    border: 7px solid transparent;
    border-block-start-color: var(--ink);
    transform: translateX(-50%);
    content: "";
  }

  .tl .tl-back {
    inline-size: fit-content;
    margin: 1.4rem auto 0;
    padding: 0.45rem 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 12px 12px 12px 2px;
    background: var(--family-accent);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .tl[data-step="1"] .tl-bad { visibility: hidden; }
  .tl[data-step="2"] .tl-here { inset-inline-start: 87.5%; }
  .tl[data-step="3"] .tl-bad { opacity: 0.3; }
  .tl[data-step="3"] .tl-good i { transform: scale(1.25); }
  .tl:not([data-step="3"]) .tl-back { visibility: hidden; }

  @media (max-width: 40rem) {
    .tl-stage { padding-inline: 0.3rem; }
    .tl .tl-line li { font-size: 0.72rem; }
    .tl .tl-here { font-size: 0.7rem; }
    .tl[data-step="2"] .tl-here { transform: translateX(-80%); }
    .tl[data-step="2"] .tl-here::after { inset-inline-start: 80%; }
  }
</style>
