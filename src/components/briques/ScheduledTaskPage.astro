---
// Où regarder dans Scheduled : la fiche d'une tâche planifiée, avec trois
// repères. Libellés repris de la documentation officielle de l'application.
import ClaudeApp from './ClaudeApp.astro';
import SideMenu from './SideMenu.astro';
---

<figure class="ca-figure stp">
  <ClaudeApp mode="code" sidebar={false} title="Scheduled tasks">
    <SideMenu mode="code" active="Scheduled" pins={{ Scheduled: 1 }}>
      <div class="stp-main">
        <div class="stp-head">
          <p class="stp-title">point-du-matin</p>
          <p class="stp-run">Run now<i class="ca-pin">2</i></p>
        </div>
        <p class="stp-line"><span>Schedule</span><b>Daily, 9:00</b></p>
        <p class="stp-line"><span>Status</span><b class="stp-status">Active<i class="stp-toggle"></i><i class="ca-pin">3</i></b></p>
        <p class="stp-label">History</p>
        <p class="stp-line stp-past"><span>Lundi, 9:02</span><b>Completed</b></p>
      </div>
    </SideMenu>
  </ClaudeApp>
  <ol class="ca-legend">
    <li><span>Ouvrez <b>Scheduled</b> : toutes vos tâches planifiées sont là.</span></li>
    <li><span><b>Run now</b> lance la tâche tout de suite, pour vérifier le résultat.</span></li>
    <li><span>Le statut met la tâche en pause, sans la supprimer.</span></li>
  </ol>
</figure>

<style>
  .stp-main {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.1rem 1.3rem 1.3rem;
  }

  .stp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-block-end: 0.4rem;
  }

  .stp .stp-title {
    font-family: var(--app-serif);
    font-size: 1.25rem;
  }

  .stp-run {
    position: relative;
    flex: none;
    padding: 0.3rem 0.8rem;
    border-radius: 7px;
    background: var(--app-text);
    color: #1f1e1d;
    font-weight: 600;
  }

  .stp-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--app-line);
    border-radius: 10px;
    background: var(--app-side);
  }

  .stp-line span { color: var(--app-muted); }
  .stp-line b { font-weight: 500; }

  .stp-status {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stp-toggle {
    inline-size: 1.9rem;
    block-size: 1.1rem;
    border-radius: 1rem;
    background: var(--app-accent) radial-gradient(circle at 1.35rem 50%, #fff 0.38rem, transparent 0.42rem);
  }

  .stp .stp-label {
    margin-block-start: 0.6rem;
    color: var(--app-muted);
    font-size: 0.72rem;
  }

  .stp-past b { color: #6fbf7f; }

  .stp .ca-pin {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    font-size: 0.85rem;
    font-style: normal;
  }

  .stp-run .ca-pin { inset: -0.75rem auto auto -0.9rem; }
  .stp-status .ca-pin { inset: 50% auto auto -2rem; translate: 0 -50%; }

  @media (max-width: 40rem) {
    .stp-main { padding: 1rem 0.7rem; }
  }
</style>
