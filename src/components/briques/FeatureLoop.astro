---
// La boucle de construction : une fonctionnalité, regarder, corriger,
// sauvegarder, puis la suivante. Schéma au style du site.
import './claude-app.css';
---

<figure class="ca-figure is-narrow fl">
  <ol class="fl-steps">
    <li><b>1</b><span>Claude construit <strong>une</strong> fonctionnalité</span></li>
    <li><b>2</b><span>Vous regardez l’aperçu</span></li>
    <li><b>3</b><span>Vous faites corriger</span></li>
    <li><b>4</b><span>Claude sauvegarde</span></li>
  </ol>
  <p class="fl-back"><span>Puis la fonctionnalité suivante</span></p>
</figure>

<style>
  .fl .fl-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl .fl-steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.4rem;
    margin: 0;
    padding: 0.7rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--ink);
    font-size: 0.9rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .fl .fl-steps li:first-child { background: var(--family-accent); }

  .fl-steps li:not(:last-child)::after {
    position: absolute;
    inset: 50% -0.95rem auto auto;
    font-size: 1rem;
    line-height: 0;
    content: "→";
  }

  .fl-steps b {
    display: inline-grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    font-family: var(--font-display);
  }

  /* Le retour : un trait qui repart de la dernière étape vers la première. */
  .fl .fl-back {
    margin: 0 12% 0;
    padding-block-start: 0.9rem;
    border: 2px solid var(--ink);
    border-block-start: 0;
    border-radius: 0 0 1rem 1rem;
    text-align: center;
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    line-height: 1;
  }

  .fl-back span {
    position: relative;
    inset-block-start: 0.5rem;
    padding-inline: 0.6rem;
    background: var(--paper);
  }

  @media (max-width: 40rem) {
    .fl .fl-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fl-steps li:nth-child(2)::after { content: none; }
  }
</style>
