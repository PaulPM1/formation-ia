---
// Visuel principal de la brique D1 : la carte du projet. Les douze mots du
// lexique y sont posés là où on les rencontre.
import './claude-app.css';
import './eco.css';
import EcoIcon from './EcoIcon.astro';
import T from './LexiconTag.astro';
---

<figure class="ca-figure pm">
  <div class="pm-map">
    <section class="eco-node pm-zone">
      <EcoIcon name="laptop" />
      <p class="eco-name">Votre ordinateur</p>
      <div class="pm-items">
        <p><T mot="Dossier" /><em><EcoIcon name="folder" />mes-recettes</em></p>
        <p><T mot="Fichier" /><em><EcoIcon name="file" />index.html</em></p>
        <p><T mot="Dépendance" /><em><EcoIcon name="box" />outils ajoutés</em></p>
        <p><T mot="Clé API" /><em><EcoIcon name="lock" />.env</em></p>
        <p><T mot="Localhost" /><em><EcoIcon name="screen" />l’aperçu</em></p>
      </div>
    </section>

    <div class="pm-link"><T mot="Commit" /><i></i><span>une sauvegarde</span></div>

    <section class="eco-node pm-zone">
      <EcoIcon name="github" />
      <p class="eco-name"><T mot="GitHub" /></p>
      <div class="pm-items">
        <p><T mot="Dépôt" /><em><EcoIcon name="folder" />mes-recettes</em></p>
        <p class="pm-history" aria-hidden="true"><u></u><u></u><u></u><span>l’historique</span></p>
      </div>
    </section>

    <div class="pm-link"><T mot="Déploiement" /><i></i><span>la mise en ligne</span></div>

    <section class="eco-node pm-zone is-key">
      <EcoIcon name="globe" />
      <p class="eco-name">En ligne</p>
      <div class="pm-items">
        <p><T mot="Front" /><em><EcoIcon name="eye" />ce qu’on voit</em></p>
        <p><T mot="Back" /><em><EcoIcon name="server" />ce qui travaille</em></p>
        <p><T mot="Base de données" /><em><EcoIcon name="database" />ce qui est retenu</em></p>
      </div>
    </section>
  </div>
</figure>

<style>
  .pm-map {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto minmax(0, 0.9fr) auto minmax(0, 1.15fr);
    align-items: stretch;
    gap: 0.7rem;
    padding: 0 6px 6px 0;
  }

  .pm .pm-zone { padding: 1.1rem 0.9rem 1.2rem; }

  .pm-items {
    display: grid;
    gap: 0.5rem;
    inline-size: 100%;
    margin-block-start: 0.7rem;
  }

  .pm .pm-items p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem 0.6rem;
    margin: 0;
    padding: 0.4rem 0.5rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .pm-items em {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
  }

  .pm-items :global(.eco-icon) { inline-size: 1rem; block-size: 1rem; }

  .pm :global(.lx-tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.55rem 0.1rem 0.15rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--brick-yellow);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  .pm :global(.lx-tag b) {
    display: grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--brick-yellow);
    font-family: var(--font-display);
    font-size: 0.72rem;
  }

  .pm .pm-items .pm-history {
    justify-content: flex-start;
    gap: 0.3rem;
  }

  .pm-history u {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--family-accent);
  }

  .pm-history span { margin-inline-start: 0.3rem; font-family: var(--font-mono); font-size: 0.72rem; }

  /* Le lien entre deux lieux : son mot, une flèche, sa traduction. */
  .pm-link {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    line-height: 1.2;
    text-align: center;
  }

  .pm-link i {
    position: relative;
    inline-size: 100%;
    min-inline-size: 4rem;
    block-size: 4px;
    background: var(--ink);
  }

  .pm-link i::after {
    position: absolute;
    inset: 50% -2px auto auto;
    border: 8px solid transparent;
    border-inline-start: 12px solid var(--ink);
    border-inline-end: 0;
    transform: translateY(-50%);
    content: "";
  }

  @media (max-width: 56rem) {
    .pm-map { grid-template-columns: minmax(0, 1fr); }
    .pm-link { grid-template-columns: auto auto auto; justify-content: center; align-items: center; gap: 0.7rem; padding-block: 0.3rem; }
    .pm-link i { inline-size: 4px; min-inline-size: 0; block-size: 2.2rem; }
    .pm-link i::after {
      inset: auto auto -2px 50%;
      border: 8px solid transparent;
      border-block-start: 12px solid var(--ink);
      border-block-end: 0;
      transform: translateX(-50%);
    }
  }
</style>
