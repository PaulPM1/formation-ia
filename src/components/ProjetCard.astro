---
import type { CollectionEntry } from 'astro:content';

import { formatDifficulty } from '../content/projet-model';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { id, order, title, tagline, deliverable, difficulty, teamHint } = projet.data;
const href = `/atelier/projets/${id}/`;
---

<article class="projet-card" data-projet={id}>
  <p class="card-kicker">
    <span>Projet {order}</span>
    <span>{teamHint}</span>
  </p>
  <h3><a href={href}>{title}</a></h3>
  <p class="projet-tagline">{tagline}</p>
  <p class="projet-difficulty">
    <span class="badge" data-difficulty={difficulty}>{formatDifficulty(difficulty)}</span>
  </p>
  <dl class="stage-facts">
    <div>
      <dt>Ce que vous montrez dimanche</dt>
      <dd>{deliverable}</dd>
    </div>
  </dl>
  <a class="text-link" href={href}>
    Voir le cahier des charges <span aria-hidden="true">→</span>
  </a>
</article>
