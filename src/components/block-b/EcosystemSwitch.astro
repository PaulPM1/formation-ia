---
interface Props {
  brickId: string;
}

const { brickId } = Astro.props;
const claudeId = `ecosystem-${brickId}-claude`;
const openAIId = `ecosystem-${brickId}-openai`;
---

<aside class="ecosystem-switch" data-block-b-ecosystem-switch>
  <fieldset>
    <legend>Choisissez votre voie pour tout le Bloc B</legend>
    <label for={claudeId}>
      <input id={claudeId} type="radio" name={`ecosystem-${brickId}`} value="claude" />
      <span>Voie Claude</span>
    </label>
    <label for={openAIId}>
      <input id={openAIId} type="radio" name={`ecosystem-${brickId}`} value="openai" />
      <span>Voie OpenAI</span>
    </label>
  </fieldset>
  <p data-block-b-ecosystem-status aria-live="polite">
    Aucun choix enregistré : les deux voies restent visibles.
  </p>
</aside>

<script>
  import {
    BLOCK_B_ECOSYSTEM_STORAGE_KEY,
    blockBPanelVisibility,
    parseBlockBEcosystem,
    type BlockBEcosystem,
  } from '../../features/block-b/ecosystem';

  document.querySelectorAll<HTMLElement>('[data-block-b-ecosystem-switch]').forEach((switcher) => {
    const page = switcher.closest<HTMLElement>('[data-block-b-experience]');
    const controls = Array.from(switcher.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const status = switcher.querySelector<HTMLElement>('[data-block-b-ecosystem-status]');
    if (!page || !status) return;

    const render = (selected: BlockBEcosystem | null) => {
      const panels = Array.from(page.querySelectorAll<HTMLElement>('[data-block-b-panel]'));
      const visibility = blockBPanelVisibility(
        selected,
        panels.map((panel) => panel.dataset.blockBPanel ?? ''),
      );
      panels.forEach((panel, index) => {
        panel.hidden = !visibility[index];
      });
      controls.forEach((control) => {
        control.checked = control.value === selected;
      });
      page.dataset.blockBEcosystem = selected ?? 'unselected';
      status.textContent = selected === null
        ? 'Aucun choix enregistré : les deux voies restent visibles.'
        : `Voie ${selected === 'claude' ? 'Claude' : 'OpenAI'} active pour le Bloc B.`;
    };

    let initial: BlockBEcosystem | null = null;
    try {
      initial = parseBlockBEcosystem(localStorage.getItem(BLOCK_B_ECOSYSTEM_STORAGE_KEY));
    } catch {}
    render(initial);

    controls.forEach((control) => {
      control.addEventListener('change', () => {
        const selected = parseBlockBEcosystem(control.value);
        if (!selected) return;
        try {
          localStorage.setItem(BLOCK_B_ECOSYSTEM_STORAGE_KEY, selected);
        } catch {}
        render(selected);
      });
    });
  });
</script>

<style>
  .ecosystem-switch {
    max-inline-size: var(--reading-width);
    margin: 2rem auto 0;
    padding: 1.25rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  fieldset {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    grid-column: 1 / -1;
    margin-block-end: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-heading);
  }

  label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-block-size: 2.75rem;
    cursor: pointer;
  }

  input {
    flex: 0 0 auto;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    margin: 0;
    accent-color: var(--ink);
  }

  label span {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.55rem 0.75rem;
    border: 2px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  input:checked + span {
    border-color: var(--ink);
    background: var(--family-accent);
    color: var(--ink);
  }

  input:checked + span::after {
    content: "Sélectionnée";
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  input:focus-visible {
    outline: 0.22rem solid var(--brick-coral);
    outline-offset: 0.18rem;
  }

  input:focus-visible + span {
    outline: 0.22rem solid var(--brick-coral);
    outline-offset: 0.18rem;
  }

  [data-block-b-ecosystem-status] {
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: var(--text-small);
  }

  :global(.block-b-path) {
    margin-block: 1.5rem;
    padding: 1rem 1.2rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--family-accent), var(--surface) 72%);
  }

  :global(.block-b-path h3) {
    margin-block-start: 0.5rem;
  }

  :global([data-block-b-panel][hidden]) {
    display: none;
  }

  @media (max-width: 38rem) {
    fieldset {
      grid-template-columns: 1fr;
    }
  }
</style>
