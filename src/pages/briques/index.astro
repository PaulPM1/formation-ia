---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getStructureCompletion,
  groupBricksByFamily,
  OWNER_LABELS,
  PRIORITY_LABELS,
  STATUS_LABELS,
} from '../../content/brick-view';
import { BRICK_COUNT } from '../../content/brick-files';

const bricks = await getCollection('briques');
const groups = groupBricksByFamily(bricks);
---

<BaseLayout
  title={`Les ${BRICK_COUNT} briques`}
  description={`Le programme complet de la formation IA, organisé en cinq blocs et ${BRICK_COUNT} briques pédagogiques.`}
>
  <header class="catalog-hero">
    <div>
      <p class="eyebrow">Le plan de construction</p>
      <h1>Les {BRICK_COUNT} briques pédagogiques</h1>
      <p class="lede">
        Six blocs pour passer des fondamentaux à un projet livré. Choisissez une
        brique, attribuez-la, puis faites-la progresser de la rédaction à la validation.
      </p>
    </div>
    <aside class="catalog-counter" aria-label={`${BRICK_COUNT} briques réparties en 5 blocs`}>
      <strong>{BRICK_COUNT}</strong>
      <span>briques</span>
      <small>5 blocs · 1 parcours</small>
    </aside>
  </header>

  <div class="catalog-groups">
    {groups.map((group, groupIndex) => (
      <section
        class="family-section"
        data-family={group.family}
        aria-labelledby={`family-${group.family}`}
      >
        <header class="family-heading">
          <span class="family-index" aria-hidden="true">0{groupIndex + 1}</span>
          <div>
            <p>Bloc {group.family.toUpperCase()}</p>
            <h2 id={`family-${group.family}`}>{group.label}</h2>
          </div>
          <span class="family-count">{group.entries.length} briques</span>
        </header>
        <ol class="brick-list" role="list">
          {group.entries.map((brick) => {
            const structure = getStructureCompletion(brick.body ?? '', brick.data.type);
            return (
              <li>
                <article class="brick-card" data-family={brick.data.family} data-priority={brick.data.priority}>
                  <p class="card-kicker">
                    <span>{brick.data.id.toUpperCase()}</span>
                    <span>ordre {brick.data.order}</span>
                  </p>
                  <h3><a href={`/briques/${brick.data.id}/`}>{brick.data.title}</a></h3>
                  <p class="meta-line">
                    <span class="badge" data-priority={brick.data.priority}>
                      {PRIORITY_LABELS[brick.data.priority]}
                    </span>
                    <span>{brick.data.durationMinutes ? `${brick.data.durationMinutes} min` : 'Durée à définir'}</span>
                  </p>
                  <div class="card-footer">
                    <p>{STATUS_LABELS[brick.data.status]} · {OWNER_LABELS[brick.data.owner]}</p>
                    <p class="structure-status">Structure {structure.complete}/{structure.total}</p>
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
