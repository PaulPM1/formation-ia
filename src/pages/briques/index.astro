---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/briques/Icon.astro';
import { groupBricksByFamily, PRIORITY_LABELS } from '../../content/brick-view';
import { BRICK_COUNT } from '../../content/brick-files';

const groups = groupBricksByFamily(await getCollection('briques'));
const bricks = groups.flatMap((group) => group.entries);

// Hero animé repris d'Antimetal (Details) : deux rangées de 8 cartes décoratives.
const TILE_COUNT = 16;
const LOOP_SECONDS = 7;
const FAMILY_ICONS = { a: 'chat', b: 'laptop', c: 'plug', d: 'code', e: 'check', f: 'folder' } as const;
const tiles = Array.from({ length: TILE_COUNT }, (_, index) => bricks[index % bricks.length]);
// Phase négative propre à chaque carte, répartie sur la boucle de 7 s (fixe d'un rendu à l'autre).
const delay = (index: number) => `-${((index * 2.618) % LOOP_SECONDS).toFixed(3)}s`;
---

<BaseLayout
  title={`Les ${BRICK_COUNT} briques`}
  description={`Le programme complet de la formation IA, organisé en cinq blocs et ${BRICK_COUNT} briques pédagogiques.`}
>
  <header class="catalog-hero catalog-hero--center">
    <h1>Les {BRICK_COUNT} briques pédagogiques</h1>
    <p class="lede">
      Cinq blocs pour passer des fondamentaux à un projet livré. Choisissez une
      brique pour commencer.
    </p>
  </header>

  <div class="brick-grid" aria-hidden="true">
    <ul class="brick-grid__track">
      {tiles.map((brick, index) => (
        <li class="brick-tile" data-family={brick.data.family} style={`--animation-delay:${delay(index)}`}>
          <span class="brick-tile__pill"></span>
          <span class="brick-tile__icon-frame">
            <span class="brick-tile__icon"><Icon name={FAMILY_ICONS[brick.data.family]} /></span>
          </span>
          <span class="brick-tile__label">{brick.data.title}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="brick-catalog">
    {groups.map((group) => (
      <section class="family-block" data-family={group.family} aria-labelledby={`family-${group.family}`}>
        <header class="family-block__head">
          <span class="family-block__pill" aria-hidden="true"><Icon name={FAMILY_ICONS[group.family]} /></span>
          <h2 id={`family-${group.family}`}>{group.label}</h2>
          <p>{group.entries.length} briques</p>
        </header>
        <ol class="brick-list" role="list">
          {group.entries.map((brick) => (
            <li>
              <a
                class="brick-card"
                href={`/briques/${brick.data.id}/`}
                data-family={brick.data.family}
                data-priority={brick.data.priority}
              >
                <span class="brick-card__code">{brick.data.id.toUpperCase()}</span>
                <span class="brick-card__title">{brick.data.title}</span>
                <span class="brick-card__meta">
                  {brick.data.priority !== 'socle' && <span class="brick-card__priority">{PRIORITY_LABELS[brick.data.priority]}</span>}
                  {brick.data.durationMinutes ? <span>{brick.data.durationMinutes} min</span> : null}
                </span>
                <span class="brick-card__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
