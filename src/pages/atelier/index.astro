---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjetCard from '../../components/ProjetCard.astro';
import { formatBudgetMinutes } from '../../content/atelier-model';

const stages = (await getCollection('atelier')).toSorted(
  (left, right) => left.data.order - right.data.order,
);
const projets = (await getCollection('projets')).toSorted(
  (left, right) => left.data.order - right.data.order,
);
const bricks = await getCollection('briques');
const brickTitles = new Map(bricks.map((brick) => [brick.data.id, brick.data.title]));

const weekend = [
  {
    when: 'Vendredi après-midi',
    label: 'Le berceau',
    detail:
      "Dossier de travail, git, Claude Code, et un CLAUDE.md d'identité écrit à partir d'une interview menée par Claude.",
  },
  {
    when: 'Vendredi soir',
    label: 'Le choix',
    detail:
      'Vous choisissez votre projet dans le catalogue et vous repartez avec sa matière première à réunir.',
  },
  {
    when: 'Samedi matin',
    label: 'La matière',
    detail:
      'Structure de dossiers, ingestion de votre matière première, règles de routage, mise sur GitHub.',
  },
  {
    when: 'Samedi après-midi',
    label: 'Le savoir-faire',
    detail:
      "Le skill qui transforme votre matière en valeur, testé et corrigé jusqu'à ce qu'il tienne.",
  },
  {
    when: 'Dimanche matin',
    label: 'Le visage et le cœur',
    detail:
      "Interface web, déploiement, audit de sécurité, puis l'étape qui distingue votre projet des autres.",
  },
  {
    when: 'Dimanche après-midi',
    label: 'La restitution',
    detail: 'La dernière étape de votre projet, puis la démonstration devant le groupe.',
  },
];
---

<BaseLayout
  title="Atelier"
  description="Un socle technique commun, cinq projets au choix : construisez le vôtre sur un week-end."
>
  <header class="catalog-hero">
    <div>
      <p class="eyebrow">L'atelier</p>
      <h1>Un socle, cinq projets</h1>
      <p class="lede">
        Tout le monde construit le même socle : un dossier versionné, une identité
        écrite, une matière rangée, un skill, une interface en ligne. Ensuite,
        chacun mène le projet qu'il a choisi. Vendredi vous partez d'un dossier
        vide, dimanche vous montrez une adresse qui fonctionne.
      </p>
      <p class="hero-actions">
        <a class="button" href="#catalogue">Voir les 5 projets</a>
        <a class="button button-light" href="#socle">Le socle commun</a>
      </p>
    </div>
    <aside class="catalog-counter" aria-label="5 projets sur un week-end">
      <strong>5</strong>
      <span>projets</span>
      <small>1 socle · 1 week-end</small>
    </aside>
  </header>

  <section class="weekend-section" aria-labelledby="deroule-titre">
    <div class="section-heading">
      <p class="eyebrow">Le déroulé</p>
      <h2 id="deroule-titre">Ce qui se passe, heure par heure</h2>
    </div>
    <ol class="weekend-track" role="list">
      {weekend.map((moment) => (
        <li class="weekend-step">
          <p class="weekend-when">{moment.when}</p>
          <p class="weekend-label">{moment.label}</p>
          <p class="weekend-detail">{moment.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="socle-section" id="socle" aria-labelledby="socle-titre">
    <div class="section-heading">
      <p class="eyebrow">Commun à tous les projets</p>
      <div>
        <h2 id="socle-titre">Le socle en quatre étapes, puis la restitution</h2>
        <p class="section-lede">
          Ces étapes se déroulent au même moment pour tout le monde. Le contenu
          change selon votre projet, l'objectif et la preuve de réussite restent
          les mêmes.
        </p>
      </div>
    </div>
    <ol class="stage-track" role="list" aria-label="Les étapes du socle, dans l'ordre du week-end">
      {stages.map((stage) => (
        <li class="stage-step" data-stage={stage.data.id}>
          <span class="family-index" aria-hidden="true">0{stage.data.order}</span>
          <article class="stage-card">
            <p class="card-kicker">
              <span>Socle commun</span>
              <span>{stage.data.durationLabel} · ≈ {formatBudgetMinutes(stage.data.budgetMinutes)}</span>
            </p>
            <h3><a href={`/atelier/${stage.data.id}/`}>{stage.data.title}</a></h3>
            <p class="stage-subtitle">{stage.data.subtitle}</p>
            <dl class="stage-facts">
              <div>
                <dt>Le but</dt>
                <dd>{stage.data.goal}</dd>
              </div>
            </dl>
            <ul class="pill-list" role="list" aria-label="Briques mobilisées">
              {stage.data.bricks.map((brickId) => (
                <li>
                  <a class="brick-pill" data-family={brickId.charAt(0)} href={`/briques/${brickId}/`}>
                    <span aria-hidden="true">{brickId.toUpperCase()}</span>
                    {brickTitles.get(brickId) ?? brickId.toUpperCase()}
                  </a>
                </li>
              ))}
            </ul>
            <a class="text-link" href={`/atelier/${stage.data.id}/`}>
              Voir l'étape en détail <span aria-hidden="true">→</span>
            </a>
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="catalogue-section" id="catalogue" aria-labelledby="catalogue-titre">
    <div class="section-heading">
      <p class="eyebrow">Le catalogue</p>
      <div>
        <h2 id="catalogue-titre">Choisissez votre projet</h2>
        <p class="section-lede">
          Cinq projets, la même colonne vertébrale en six étapes, des matières et
          des finalités différentes. Choisissez celui dont vous avez déjà la
          matière première sous la main : c'est le meilleur critère.
        </p>
      </div>
    </div>
    <div class="projet-grid">
      {projets.map((projet) => (
        <ProjetCard projet={projet} brickTitles={brickTitles} />
      ))}
    </div>
  </section>
</BaseLayout>
