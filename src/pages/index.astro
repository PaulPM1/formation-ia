---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRICK_COUNT } from '../content/brick-files';
---

<BaseLayout
  title="Les briques du Vibe Coding"
  description={`Un week-end pour comprendre l’IA, prendre Claude en main et lancer votre propre projet, en ${BRICK_COUNT} briques.`}
>
  <section class="home-hero" data-ascii-wind aria-labelledby="home-title">
    <div class="home-copy">
      <h1 id="home-title">Les briques du Vibe Coding</h1>
      <p class="home-lede">
        Un week-end pour comprendre l’IA, prendre Claude en main
        et lancer votre propre projet.
      </p>
      <a class="button button-primary" href="/briques/">Découvrir les {BRICK_COUNT} briques</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAsciiWind2 } from '../scripts/ascii-wind.js';

  const root = document.querySelector<HTMLElement>('[data-ascii-wind]');
  if (root) {
    const stopAsciiWind2 = initAsciiWind2(root, 'wind');
    window.addEventListener('pagehide', (event) => { if (!event.persisted) stopAsciiWind2(); });
  }
</script>
