---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Le support public de la formation Les briques du Vibe Coding.',
} = Astro.props;

const pageTitle = `${title} · Formation IA`;
const isHome = Astro.url.pathname === '/';
const isBricks = Astro.url.pathname.startsWith('/briques');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffbf3f" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Inter:wght@100..900&family=Geist+Mono:wght@100..700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigation principale">
        <a class="brand" href="/" aria-label="Les briques du Vibe Coding — accueil">
          <span class="brand-mark" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="brand-copy">Les briques <small>du Vibe Coding</small></span>
        </a>
        <ul class="nav-links" role="list">
          <li><a href="/" aria-current={isHome ? 'page' : undefined}>Accueil</a></li>
          <li><a href="/briques/" aria-current={isBricks ? 'page' : undefined}>Les 24 briques</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p><strong>Les briques du Vibe Coding</strong><br />Un curriculum public, construit pour passer de l’idée au projet livré.</p>
        <a href="/briques/">Explorer le programme <span aria-hidden="true">→</span></a>
      </div>
    </footer>
  </body>
</html>
