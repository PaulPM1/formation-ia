---
import '../styles/global.css';
import '../styles/faq.css';
import { BRICK_COUNT } from '../content/brick-files';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Le support public de la formation Les briques du Vibe Coding.',
} = Astro.props;

const pageTitle = `${title} · Formation IA`;
const isHome = Astro.url.pathname === '/';
const isBricks = Astro.url.pathname.startsWith('/briques');
const isAtelier = Astro.url.pathname.startsWith('/atelier');
const isPresentation = Astro.url.pathname.startsWith('/presenter');
const isFaq = Astro.url.pathname.startsWith('/faq');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0b" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class={isHome ? 'is-home' : undefined}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigation principale">
        <a class="brand" href="/" aria-label="Les briques du Vibe Coding, accueil">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-copy">Les briques du Vibe Coding</span>
        </a>
        <ul class="nav-links" role="list">
          <li><a href="/" aria-current={isHome ? 'page' : undefined}>Accueil</a></li>
          <li><a href="/faq/" aria-current={isFaq ? 'page' : undefined}>Questions fréquentes</a></li>
          <li><a href="/briques/" aria-current={isBricks ? 'page' : undefined}>Les {BRICK_COUNT} briques</a></li>
          <li><a href="/atelier/" aria-current={isAtelier ? 'page' : undefined}>Atelier</a></li>
          <li><a href="/presenter/" aria-current={isPresentation ? 'page' : undefined}>Présentation</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p><strong>Les briques du Vibe Coding</strong><br />De l’idée au projet en ligne, avec Claude.</p>
        <a href="/briques/">Explorer le programme <span aria-hidden="true">→</span></a>
      </div>
    </footer>
  </body>
</html>
